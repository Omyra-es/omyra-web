---
// Hero: «Tú trabajas» (profesionales de distintos sectores trabajando) + «Tus clientes reservan»
// (aviso de nueva reserva que llega a la vez).
import { Image } from 'astro:assets';
import { photos } from '../content/photos';
const slides = [
  { id: 'pestanas', sector: 'Estética y belleza', what: 'Lifting de pestañas', when: 'jue 19 nov · 10:30' },
  { id: 'peluqueria', sector: 'Peluquería', what: 'Corte y peinado', when: 'jue 19 nov · 18:00' },
  { id: 'westie', sector: 'Peluquería y spa canino', what: 'Baño y corte', when: 'vie 20 nov · 10:00' },
  { id: 'tatuaje', sector: 'Estudio de tatuaje', what: 'Sesión de tatuaje', when: 'vie 20 nov · 16:00' },
  { id: 'spa', sector: 'Spa', what: 'Masaje con piedras calientes', when: 'sáb 21 nov · 11:00' },
  { id: 'fisio', sector: 'Fisioterapia', what: 'Sesión de fisioterapia', when: 'lun 23 nov · 17:00' },
] as const;
const n = slides.length;
---
<div class="reel" style={`--n:${n}`} aria-label="Profesionales de distintos sectores trabajando mientras llegan nuevas reservas online">
  <div class="reel__photos">
    {slides.map((s, i) => (
      <div class="reel__slide" style={`--i:${i}`}>
        <Image src={photos[s.id].img} alt={photos[s.id].alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 46vw, 92vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} format="webp" quality={76} />
        <span class="reel__tag">{s.sector}</span>
      </div>
    ))}
  </div>
  <div class="reel__notes" aria-hidden="true">
    {slides.map((s, i) => (
      <div class="reel__note" style={`--i:${i}`}>
        <span class="reel__ic">+</span>
        <span><b>Nueva reserva online</b><small>{s.what} · {s.when}</small></span>
      </div>
    ))}
  </div>
  <div class="reel__bar" aria-hidden="true">{slides.map((_, i) => <i style={`--i:${i}`}></i>)}</div>
</div>
<style>
  .reel { --t: 3.4s; position: relative; height: clamp(360px, 32vw, 500px); }
  .reel__photos { position: absolute; inset: 0 0 0 8%; border-radius: 180px 32px 32px 32px; overflow: hidden; background: var(--deep); box-shadow: var(--shadow); }
  .reel__slide { position: absolute; inset: 0; opacity: 0; animation: reel-photo calc(var(--t) * var(--n)) calc(var(--t) * var(--i)) infinite; }
  .reel__slide :global(img) { width: 100%; height: 100%; object-fit: cover; animation: reel-zoom calc(var(--t) * var(--n)) calc(var(--t) * var(--i)) infinite; }
  .reel__slide::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgb(10 43 32 / .55)); }
  .reel__tag { position: absolute; z-index: 2; right: 18px; top: 18px; background: var(--lilac); color: var(--deep); font-weight: 700; font-size: .92rem; padding: .55em 1em; border-radius: 99px; opacity: 0; animation: reel-tag calc(var(--t) * var(--n)) calc(var(--t) * var(--i)) infinite; }
  .reel__notes { position: absolute; left: 0; bottom: 34px; z-index: 3; width: min(340px, 82%); height: 74px; }
  .reel__note { position: absolute; inset: 0; display: flex; align-items: center; gap: 12px; background: var(--cream-l); color: var(--ink); border-radius: 20px; padding: 12px 18px 12px 12px; box-shadow: 0 22px 44px -16px rgb(0 0 0 / .55); opacity: 0; animation: reel-note calc(var(--t) * var(--n)) calc(var(--t) * var(--i)) infinite; }
  .reel__ic { width: 42px; height: 42px; flex: none; border-radius: 13px; display: grid; place-items: center; background: var(--lime); color: var(--deep); font-weight: 800; font-size: 1.3rem; rotate: -6deg; }
  .reel__note b { display: block; font-size: 1rem; }
  .reel__note small { display: block; color: var(--muted); font-size: .84rem; }
  .reel__bar { position: absolute; left: 8%; right: 0; bottom: -18px; display: flex; gap: 6px; }
  .reel__bar i { flex: 1; height: 4px; border-radius: 4px; background: rgb(247 245 241 / .18); overflow: hidden; position: relative; }
  .reel__bar i::after { content: ''; position: absolute; inset: 0; background: var(--lime); transform: scaleX(0); transform-origin: left; animation: reel-bar calc(var(--t) * var(--n)) calc(var(--t) * var(--i)) infinite linear; }
  .reel__cap { position: absolute; right: 0; bottom: -46px; font: 500 .68rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--on-dark); }
  @keyframes reel-photo { 0% { opacity: 0; } 2%, 16.7% { opacity: 1; } 18.7%, 100% { opacity: 0; } }
  @keyframes reel-tag { 0%, 3% { opacity: 0; transform: translateY(-8px) rotate(4deg); } 4.7%, 15% { opacity: 1; transform: rotate(4deg); } 16.3%, 100% { opacity: 0; transform: translateY(6px) rotate(4deg); } }
  @keyframes reel-zoom { 0% { transform: scale(1.1); } 20% { transform: scale(1); } 100% { transform: scale(1); } }
  @keyframes reel-note { 0%, 2.5% { opacity: 0; transform: translateY(26px) scale(.95); } 5.8%, 15.8% { opacity: 1; transform: none; } 19%, 100% { opacity: 0; transform: translateY(-14px); } }
  @keyframes reel-bar { 0% { transform: scaleX(0); } 16.67% { transform: scaleX(1); } 16.68%, 100% { transform: scaleX(0); } }
  @media (prefers-reduced-motion: reduce) {
    .reel__slide, .reel__note, .reel__tag, .reel__slide :global(img), .reel__bar i::after { animation: none; }
    .reel__slide:first-child, .reel__note:first-child, .reel__slide:first-child .reel__tag { opacity: 1; }
  }
  @media (max-width: 640px) { .reel__photos { inset: 0; border-radius: 120px 24px 24px 24px; } .reel__bar { left: 0; } .reel__notes { left: 10px; bottom: 22px; } }
</style>
