---
// Bloques animados (sin capturas) reutilizables.
---
<div class="sx ax" data-in aria-label="Agenda de Omyra: vistas, citas por profesional y estado, y huecos libres">
  <div class="sx__t ax__cal" style="--k:0">
    <div class="ax__top"><p class="sx__h">Jueves 19 nov</p><div class="ax__views"><span>Día</span><span>Semana</span><span>Mes</span><i></i></div></div>
    <div class="ax__grid">
      <div class="ax__col"><b><span class="sx__av">L</span>Laura</b>
        <span class="ax__ap ax__ap--ok" style="--t:0;--h:2">10:00 · Corte y peinado<small>Confirmada</small></span>
        <span class="ax__ap ax__ap--move" style="--t:3;--h:2">12:30 · Manicura<small>Reprogramada</small></span>
        <span class="ax__ap ax__ap--pen" style="--t:5;--h:2">16:00 · Tinte de raíz<small>Pendiente</small></span>
      </div>
      <div class="ax__col"><b><span class="sx__av sx__av--2">V</span>Valeria</b>
        <span class="ax__ap ax__ap--ok" style="--t:1;--h:2">11:00 · Lifting de pestañas<small>Confirmada</small></span>
        <span class="ax__ap ax__ap--new" style="--t:3;--h:2">14:00 · Microblading<small>Nueva</small></span>
        <span class="ax__free" style="--t:6;--h:1">Último hueco · 19:00</span>
      </div>
    </div>
  </div>
</div>
<style>
  .sx { display: grid; grid-template-columns: repeat(6, 1fr); gap: .8rem; }
  .sx__t { border-radius: 22px; padding: 1.1rem 1.2rem; background: var(--white); box-shadow: 0 20px 40px -26px rgb(10 43 32 / .45); display: grid; gap: .45rem; align-content: start; opacity: 0; translate: 0 30px; transition: opacity .7s var(--ease), translate .7s var(--ease); transition-delay: calc(var(--k) * .12s); }
  .sx:global(.is-in) .sx__t { opacity: 1; translate: 0 0; }
  .sx__h { font: 600 .72rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .sx__t small { color: var(--muted); font-size: .85rem; }
  .sx__av { width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center; background: var(--green); color: var(--lime); font-weight: 700; font-size: .8rem; }
  .sx__av--2 { background: var(--lilac); color: var(--deep); } .sx__av--3 { background: var(--cream); color: var(--green); font-size: .7rem; }
  .ax__cal { grid-column: 1 / 7; gap: .8rem; }
  .ax__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .ax__views { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); background: var(--cream); border-radius: 10px; padding: 3px; font-size: .78rem; font-weight: 700; }
  .ax__views span { position: relative; z-index: 1; padding: .35rem .7rem; text-align: center; color: var(--green); }
  .ax__views i { position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc((100% - 6px) / 3); border-radius: 8px; background: var(--lime); animation: ax-v 9s infinite cubic-bezier(.6, 0, .3, 1); }
  @keyframes ax-v { 0%, 30% { transform: none; } 36%, 63% { transform: translateX(100%); } 69%, 96% { transform: translateX(200%); } 100% { transform: none; } }
  .ax__grid { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
  .ax__col { position: relative; display: grid; grid-template-rows: auto repeat(7, 34px); gap: 4px; background: repeating-linear-gradient(180deg, transparent 0 37px, rgb(15 61 46 / .07) 37px 38px); border-radius: 12px; }
  .ax__col > b { display: flex; align-items: center; gap: .45rem; color: var(--green); font-size: .9rem; padding-bottom: .3rem; }
  .ax__ap, .ax__free { grid-row: calc(var(--t) + 2) / span var(--h); border-radius: 10px; padding: .4rem .6rem; font-size: .76rem; font-weight: 700; display: grid; align-content: start; }
  .ax__cal .ax__ap small { font-weight: 500; font-size: .7rem; opacity: .8; color: inherit; }
  .ax__ap--ok { background: var(--green); color: var(--cream-l); }
  .ax__ap--pen { background: var(--cream); color: var(--green); border: 1.5px dashed rgb(15 61 46 / .35); }
  .ax__ap--new { background: var(--lime); color: var(--deep); animation: ax-new 4s infinite; }
  .ax__ap--move { background: var(--lilac); color: var(--deep); animation: ax-move 6s infinite cubic-bezier(.6, 0, .3, 1); }
  @keyframes ax-new { 0%, 100% { box-shadow: 0 0 0 0 rgb(215 243 107 / .0); } 50% { box-shadow: 0 0 0 6px rgb(215 243 107 / .45); } }
  @keyframes ax-move { 0%, 40% { transform: translateY(-38px); opacity: .55; } 55%, 100% { transform: none; opacity: 1; } }
  .ax__free { background: transparent; border: 2px dashed var(--lilac); color: var(--deep); align-content: center; text-align: center; }
  @media (max-width: 640px) { .ax__grid { grid-template-columns: 1fr 1fr; } .ax__ap { font-size: .68rem; } .ax__top { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 640px) { .sx { grid-template-columns: 1fr; } .sx__t { grid-column: 1 / -1 !important; } }
  @media (prefers-reduced-motion: reduce) { .sx__t { opacity: 1; translate: none; } .ax__views i, .ax__ap--new, .ax__ap--move { animation: none; } }
</style>
