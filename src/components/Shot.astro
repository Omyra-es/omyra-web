---
// Captura real del panel de Omyra dentro de una ventana de navegador neutra.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; url?: string; crop?: string; position?: string; class?: string; eager?: boolean }
const { src, alt, url = 'omyra.es', crop, position = 'top left', class: cls, eager = false } = Astro.props;
---
<figure class:list={['shot', cls]}>
  <div class="shot__bar" aria-hidden="true"><i></i><i></i><i></i><span>{url}</span></div>
  <div class="shot__img" style={crop ? `aspect-ratio:${crop}` : undefined}>
    <Image src={src} alt={alt} widths={[600, 900, 1200]} sizes="(min-width: 1100px) 760px, 92vw" loading={eager ? 'eager' : 'lazy'} format="webp" quality={84} style={`object-position:${position}`} />
  </div>
</figure>
<style>
  .shot { border-radius: 18px; overflow: hidden; background: #fff; box-shadow: var(--shadow), 0 0 0 1px rgb(15 61 46 / .08); }
  .shot__bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: #EEE9DF; }
  .shot__bar i { width: 10px; height: 10px; border-radius: 50%; background: #D4CCBC; }
  .shot__bar span { margin-left: 12px; flex: 1; max-width: 260px; font: 500 .74rem/1 var(--mono); color: var(--muted); background: #fff; border-radius: 99px; padding: 6px 12px; }
  .shot__img { overflow: hidden; }
  .shot__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
