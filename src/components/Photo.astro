---
import { Image } from 'astro:assets';
import { photos } from '../content/photos';
interface Props { id: keyof typeof photos; sizes?: string; class?: string; eager?: boolean; caption?: boolean }
const { id, sizes = '(min-width: 900px) 40vw, 90vw', class: cls, eager = false, caption = true } = Astro.props;
const p = photos[id] as (typeof photos)[keyof typeof photos] & { pos?: string };
---
<figure class:list={['photo', cls]}>
  <Image src={p.img} alt={p.alt} widths={[400, 700, 1000, 1400]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} format="webp" quality={76} style={p.pos ? `object-position:${p.pos}` : undefined} />
  {caption && <figcaption>{p.label}</figcaption>}
</figure>
<style>
  .photo { position: relative; overflow: hidden; border-radius: 24px; background: var(--green); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .photo:hover :global(img) { transform: scale(1.05); }
  .photo figcaption { position: absolute; left: 16px; bottom: 12px; font-size: clamp(1.3rem, 1rem + 1.2vw, 2.4rem); font-weight: 600; letter-spacing: -.045em; color: #fff; text-shadow: 0 2px 24px rgb(0 0 0 / .45); }
</style>
