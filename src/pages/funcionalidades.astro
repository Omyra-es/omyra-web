---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Frag from '../components/Frag.astro';
import BookingFlow from '../components/BookingFlow.astro';
import ClientCard from '../components/ClientCard.astro';
import AgendaCard from '../components/AgendaCard.astro';
import Phone from '../components/Phone.astro';
import FinalCta from '../components/FinalCta.astro';
import { cta } from '../content/site';
import type { ImageMetadata } from 'astro';

import agendaSemana from '../assets/frag/equipo-semana.jpg';
import servicios from '../assets/frag/servicios-columnas.jpg';
import { Image } from 'astro:assets';
import documentos from '../assets/frag/doc-consentimiento.jpg';
import fichaHab from '../assets/frag/ficha-habitos.jpg';
import reserva from '../assets/luna/reserva-4-fecha.jpg';
import ficha from '../assets/producto/movil-cliente-ficha.png';
import agendaMovil from '../assets/producto/movil-agenda-dia.png';
import pagosOpc from '../assets/frag/pagos-opciones.jpg';
import bonoModal from '../assets/frag/bono-modal.jpg';
import promoModal from '../assets/frag/promo-modal.jpg';
import informePref from '../assets/frag/informe-preferencias.jpg';
import fNotas from '../assets/frag/ficha-notas.jpg';

type Area = { id: string; nav: string; title: string; pain: string; text: string; points: string[]; tone: string; shot?: ImageMetadata; phone?: ImageMetadata; alt?: string; tiles?: string[]; frags?: { src: ImageMetadata; alt: string; x: string; y: string; w: string; r: string }[]; ar?: string; steps?: { t: string; d: string }[]; video?: string; poster?: string; custom?: string };
const areas: Area[] = [
  { id: 'agenda', nav: 'Agenda', tone: 'light', title: 'Organiza tu agenda', pain: '«¿Quién está libre el jueves a las 5?»', text: 'Todas las citas del equipo en un mismo sitio, con la ocupación de cada profesional.', points: ['Vista diaria, semanal y mensual', 'Citas por profesional y por estado', 'Crear, confirmar, reprogramar o cancelar citas', 'Huecos libres y último hueco del día'], custom: 'agenda' },
  { id: 'reservas', nav: 'Reservas online', tone: 'green', title: 'Facilita las reservas', pain: '«Te escribo para pedir cita…» a las 23:40.', text: 'Tu página de reservas propia, con tu marca, abierta a cualquier hora.', points: ['Servicio, profesional, fecha y hora', 'Tu logo, tus colores y tus fotos', 'Solo los huecos que tú habilitas', 'Confirmación y recordatorio por correo'], custom: 'reservas' },
  { id: 'servicios', nav: 'Servicios y equipo', tone: 'cream', title: 'Servicios y equipo', pain: '«¿Esto lo hace Laura o Valeria?»', text: 'Tu catálogo y tu equipo, conectados: cada profesional con sus servicios, su horario y sus ausencias.', points: ['Categorías, fotos, duración y precio', 'Visibilidad pública o interna', 'Instrucciones previas en texto o documento', 'Citas de valoración previa', 'Profesionales ilimitados, con dos turnos al día, ausencias y festivos'], custom: 'servicios' },
  { id: 'clientes', nav: 'Clientes y documentos', tone: 'deep', title: 'Conoce a tus clientes', pain: '«La última vez, ¿qué le hicimos?»', text: 'La ficha de cada cliente con su historial, sus hábitos, tus notas y sus documentos.', points: ['Historial de citas y servicios', 'Notas internas, fotos y archivos', 'Consentimientos con firma por enlace', 'Caducidad y versiones de cada documento'], custom: 'clientes' },
  { id: 'pagos', nav: 'Pagos', tone: 'light', title: 'Pagos y señales', pain: '«¿Esta cita ya la había pagado?»', text: 'Registra cada cobro y, si lo necesitas, pide una señal al reservar.', points: ['Registro de cobros: efectivo, tarjeta, Bizum y transferencia', 'Pago manual por Bizum o transferencia, con plazo', 'Stripe para cobrar con tarjeta (se activa)', 'Informe del día con los cobros por método'], custom: 'pagos' },
  { id: 'bonos', nav: 'Bonos y promociones', tone: 'green', title: 'Bonos y promociones', pain: '«¿Cuántas sesiones le quedan del bono?»', text: 'Vende bonos de sesiones y lanza códigos de descuento para tus servicios.', points: ['Bonos de sesiones con precio de venta y caducidad', 'Asignados desde la ficha del cliente', 'Códigos con porcentaje o importe fijo, fechas y servicios', 'Límites de uso totales y por cliente'], custom: 'bonos' },
  { id: 'facturacion', nav: 'Facturación', tone: 'deep', title: 'Facturación con VERI*FACTU', pain: '«¿Me pasas las facturas del trimestre?» — tu gestoría', text: 'Crea y emite tus facturas desde Omyra y tenlas listas para tu gestoría.', points: ['Facturas completas y simplificadas', 'Series, conceptos, descuentos e IVA del 4, 10 o 21 %', 'Emisión con VERI*FACTU y estado de cada factura', 'PDF y exportación por periodo para tu gestoría'], steps: [
    { t: 'Borrador', d: 'Completa o simplificada' }, { t: 'Emisión', d: 'Con VERI*FACTU' }, { t: 'Estado', d: 'Aceptada o pendiente' }, { t: 'Gestoría', d: 'PDF y exportación' } ] },
  { id: 'informes', nav: 'Informes', tone: 'light', title: 'Informes de actividad', pain: '«¿Cuánto hemos cobrado hoy en efectivo?»', text: 'El informe diario y el dashboard te cuentan cómo va tu negocio sin hacer cuentas.', points: ['Citas del día, completadas y sin cobro', 'Cobros por método: efectivo, tarjeta, Bizum o transferencia', 'Clientes nuevos, ventas de bonos y sesiones consumidas', 'Resumen diario por correo cada mañana y semanal los lunes'], custom: 'informes' },
  { id: 'movil', nav: 'En tu móvil', tone: 'cream', title: 'Tu negocio, en tu móvil', pain: '«Estoy fuera, ¿cómo va la tarde?»', text: 'Mira cómo va el día desde el móvil y conecta Omyra con tu WhatsApp Business y con Google Calendar.', points: ['Agenda, clientes y avisos, siempre a mano', 'Te avisa de cada nueva reserva en el móvil, aunque no estés dentro de Omyra', 'Asistente de citas en tu WhatsApp Business, y una alerta en el dashboard cuando un mensaje necesita tu respuesta', 'Cada profesional ve sus citas de Omyra en su Google Calendar'], phone: agendaMovil, alt: 'Agenda del día de Omyra en el móvil' },
];
---
<Base title="Funcionalidades · Agenda, reservas, clientes, pagos y facturación | Omyra" description="Todo lo que necesita un negocio con citas: agenda del equipo, reservas online con tu marca, servicios, clientes y documentos, pagos, bonos, promociones, facturación con VERI*FACTU y móvil.">
  <PageHero eyebrow="Funcionalidades" title="Todo lo que necesita <span class='gold'>un negocio con citas.</span>" lead="Desde que tu cliente reserva hasta que emites la factura. Sin cambiar de herramienta y con un único precio.">
    <Fragment slot="actions"><Button href={cta.start.href} size="lg" arrow>{cta.start.label}</Button><Button href={cta.demo.href} variant="ghost" size="lg">{cta.demo.label}</Button></Fragment>
  </PageHero>

  <nav class="toc" aria-label="Áreas de Omyra">
    <div class="wrap toc__in">{areas.map((a) => <a href={`#${a.id}`}>{a.nav}</a>)}</div>
  </nav>

  {areas.map((a, i) => (
    <section id={a.id} class:list={['sec area', `area--${a.tone}`, ['green', 'deep'].includes(a.tone) ? 'is-dark' : 'is-light']}>
      <div class:list={['wrap split', i % 2 ? 'split--wide-l area--rev' : 'split--wide-r']}>
        <div class="area__text">
          <p class="eyebrow reveal">{String(i + 1).padStart(2, '0')} · {a.nav}</p>
          <p class="area__pain reveal">{a.pain}</p>
          <h2 class="h2 balance reveal">{a.title}</h2>
          <p class="lead reveal">{a.text}</p>
          <ul class="ring-list">{a.points.map((p) => <li class="reveal">{p}</li>)}</ul>
        </div>
        <div class="area__vis reveal">
          {a.shot && <div data-in><Frag src={a.shot} alt={a.alt!} r={i % 2 ? '1.5deg' : '-1.5deg'} /></div>}
          {a.phone && <div class="area__phone">{a.video ? <Phone video={a.video} poster={a.poster} alt={a.alt!} width="280px" /> : <Phone src={a.phone} alt={a.alt!} width="260px" />}</div>}
          {a.custom === 'reservas' && <BookingFlow />}
          {a.custom === 'clientes' && <ClientCard />}
          {a.custom === 'agenda' && <AgendaCard />}
          {a.custom === 'bonos' && (
            <div class="sx bx" data-in aria-label="Bonos y códigos promocionales en Omyra">
              <div class="sx__t bx__bono" style="--k:0">
                <p class="sx__h">Bono · 5 sesiones</p>
                <p class="bx__n"><span class="bx__c"><span>2</span><span>3</span></span><small>de 5 usadas</small></p>
                <div class="bx__bar"><i></i><i></i><i class="bx__fill"></i><i></i><i></i></div>
                <small>Precio de venta · caduca a los 6 meses</small>
              </div>
              <div class="sx__t bx__ficha" style="--k:1">
                <p class="sx__h">Ficha de Eva Prado</p>
                <span class="bx__as"><span class="sx__av sx__av--2">EP</span><b>Bono asignado</b><em>✓</em></span>
              </div>
              <div class="sx__t bx__code" style="--k:2">
                <p class="sx__h">Código promocional</p>
                <b class="bx__ticket">PRIMAVERA10</b>
                <span class="bx__val"><span>−10 %</span><span>−5 €</span></span>
                <small>Del 1 al 31 de marzo · Manicura y pedicura</small>
              </div>
              <div class="sx__t bx__lim" style="--k:3">
                <p class="sx__h">Límites de uso</p>
                <ul role="list"><li><b>50</b>usos totales</li><li><b>1</b>por cliente</li></ul>
              </div>
            </div>
          )}
          {a.custom === 'informes' && (
            <div class="sx ix" data-in aria-label="Informe diario de Omyra: citas, cobros por método, clientes nuevos y bonos, y resumen por correo">
              <div class="sx__t ix__kpi" style="--k:0">
                <p class="sx__h">Informe del día</p>
                <ul role="list"><li><b>12</b>citas</li><li><b>10</b>completadas</li><li class="ix__warn"><b>1</b>sin cobro</li></ul>
              </div>
              <div class="sx__t px__rep ix__pay" style="--k:1">
                <p class="sx__h">Cobros por método</p>
                <ul role="list">
                  <li><span>Efectivo</span><i style="--v:.75"></i></li>
                  <li><span>Tarjeta</span><i style="--v:.6"></i></li>
                  <li><span>Bizum</span><i style="--v:.35"></i></li>
                  <li><span>Transferencia</span><i style="--v:.15"></i></li>
                </ul>
              </div>
              <div class="sx__t ix__more" style="--k:2">
                <ul role="list"><li><b>3</b>clientes nuevos</li><li><b>2</b>bonos vendidos</li><li><b>4</b>sesiones de bono</li></ul>
              </div>
              <div class="sx__t ix__mail" style="--k:3">
                <span class="ix__env" aria-hidden="true"><i></i></span>
                <div><b>Resumen del día · 08:00</b><small>Cada mañana en tu correo. Y el semanal, los lunes.</small></div>
              </div>
            </div>
          )}
          {a.custom === 'pagos' && (
            <div class="sx px" data-in aria-label="Pagos en Omyra: registro de cobros, pago manual con plazo, Stripe e informe del día">
              <div class="sx__t px__reg" style="--k:0">
                <p class="sx__h">Registro de cobros · Lifting de pestañas · 45,00 €</p>
                <div class="px__m">{['Efectivo', 'Tarjeta', 'Bizum', 'Transferencia'].map((m, k) => <span style={`--m:${k}`}>{m}</span>)}</div>
                <span class="px__ok">✓ Cobro registrado</span>
              </div>
              <div class="sx__t px__man" style="--k:1">
                <p class="sx__h">Pago manual</p>
                <b class="px__big">Bizum o transferencia</b>
                <div class="px__bar"><i></i></div>
                <span class="px__st"><span class="px__s1">Pendiente · dentro del plazo</span><span class="px__s2">✓ Pago recibido</span></span>
              </div>
              <div class="sx__t px__str" style="--k:2">
                <p class="sx__h">Tarjeta</p>
                <b class="px__big">Stripe</b>
                <small>Garantía o depósito al reservar. El dinero va a tu cuenta.</small>
                <span class="px__chip">Se activa</span>
              </div>
              <div class="sx__t px__rep" style="--k:3">
                <p class="sx__h">Informe del día · cobros por método</p>
                <ul role="list">
                  <li><span>Tarjeta</span><i style="--v:.8"></i></li>
                  <li><span>Efectivo</span><i style="--v:.55"></i></li>
                  <li><span>Bizum</span><i style="--v:.4"></i></li>
                  <li><span>Transferencia</span><i style="--v:.2"></i></li>
                </ul>
              </div>
            </div>
          )}
          {a.custom === 'servicios' && (
            <div class="sx" data-in>
              <div class="sx__t sx__cat" style="--k:0">
                <span class="sx__lab">Peluquería · 9 servicios</span>
                <Image src={servicios} alt="Catálogo de servicios de Omyra con foto, descripción, duración y precio" widths={[500, 800, 1100]} sizes="(min-width: 900px) 44vw, 92vw" format="webp" quality={84} />
              </div>
              <div class="sx__t sx__vis" style="--k:1">
                <p class="sx__h">Visibilidad</p>
                <div class="sx__sw"><span>Público</span><span>Interno</span><i></i></div>
                <small>Tú decides qué se reserva online.</small>
              </div>
              <div class="sx__t sx__team" style="--k:2">
                <p class="sx__h">Tu equipo</p>
                <ul role="list">
                  <li><span class="sx__av">L</span><b>Laura</b><em>10:00–14:00</em><em>16:00–20:00</em></li>
                  <li><span class="sx__av sx__av--2">V</span><b>Valeria</b><em class="sx__off">Ausencia · vacaciones</em></li>
                  <li class="sx__fest"><span class="sx__av sx__av--3">8</span><b>8 dic</b><em>Festivo</em></li>
                </ul>
                <span class="sx__add">+ Profesionales ilimitados</span>
              </div>
            </div>
          )}
          {a.tiles && <div class="tiles" aria-hidden="true">{a.tiles.map((t, k) => <span style={`--k:${k}`}>{t}</span>)}</div>}
          {a.frags && <div class="stack" data-in style={`--ar:${a.ar ?? '1 / 1'}`}>{a.frags.map((f, k) => <Frag src={f.src} alt={f.alt} x={f.x} y={f.y} w={f.w} r={f.r} z={k + 1} p={k ? '-36px' : '14px'} />)}</div>}
          {a.steps && <ol class="flow" role="list" data-in>{a.steps.map((st, k) => <li style={`--k:${k}`}><span class="flow__n">{String(k + 1).padStart(2, '0')}</span><b>{st.t}</b><small>{st.d}</small></li>)}</ol>}
        </div>
      </div>
    </section>
  ))}

  <FinalCta />
</Base>

<style>
  .toc { position: sticky; top: 72px; z-index: 20; background: var(--cream); border-bottom: 1px solid var(--line); }
  .toc__in { display: flex; gap: .4rem; overflow-x: auto; padding-block: .7rem; scrollbar-width: none; }
  .toc a { flex: none; text-decoration: none; padding: .5rem 1rem; border-radius: 99px; font-size: .9rem; font-weight: 600; color: var(--green); background: rgb(15 61 46 / .06); }
  @media (min-width: 901px) { .toc__in { flex-wrap: wrap; justify-content: center; overflow: visible; gap: .35rem; } .toc a { padding: .45rem .85rem; font-size: .86rem; } }
  @media (max-width: 900px) { .toc__in { width: 100%; padding-inline: var(--gutter); mask-image: linear-gradient(90deg, #000 85%, transparent); } }
  .toc a:hover { background: var(--green); color: var(--cream-l); }
  .area--light { background: var(--cream-l); } .area--cream { background: var(--cream); }
  .area--green { background: var(--green); color: var(--cream-l); } .area--deep { background: var(--deep); color: var(--cream-l); }
  .area__text { display: grid; gap: 1.1rem; }
  .area__pain { font-size: clamp(1.1rem, 1rem + .5vw, 1.35rem); font-style: italic; color: var(--gold-ink); }
  .is-dark .area__pain { color: var(--gold); }
  .area--rev .area__vis { order: -1; }
  .area__phone { display: flex; justify-content: center; }
  .flow { list-style: none; display: grid; gap: .8rem; counter-reset: f; }
  .flow li { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 1rem; align-items: center; padding: 1.1rem 1.4rem; border-radius: 20px; background: rgb(247 245 241 / .06); box-shadow: inset 0 0 0 1px var(--line-dark); margin-left: calc(var(--k) * 6%); rotate: calc((var(--k) - 1.5) * 1deg); opacity: 0; translate: -30px 0; transition: opacity .7s var(--ease), translate .7s var(--ease); transition-delay: calc(var(--k) * .15s); }
  .flow:global(.is-in) li { opacity: 1; translate: 0 0; }
  .flow__n { grid-row: span 2; width: 52px; height: 38px; display: grid; place-items: center; border-radius: 10px; background: var(--lilac); color: var(--deep); font: 600 .85rem/1 var(--mono); transform: skewX(-10deg); }
  .flow li:nth-child(even) .flow__n { background: var(--lime); }
  .flow b { font-size: 1.3rem; letter-spacing: -.02em; }
  .flow small { color: var(--on-dark); font-size: .92rem; }
  @media (prefers-reduced-motion: reduce) { .flow li { opacity: 1; translate: none; } }
  .tiles { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; padding: 2rem; }
  .tiles span { padding: 1.1rem 1.6rem; border-radius: 99px; font-size: clamp(1.1rem, 1rem + .8vw, 1.6rem); font-weight: 600; letter-spacing: -.02em; background: var(--green); color: var(--cream-l); rotate: calc((var(--k) - 2) * 2deg); box-shadow: var(--shadow); }
  .tiles span:nth-child(odd) { background: var(--gold); color: var(--deep); }
  .is-dark .tiles span { background: var(--cream-l); color: var(--green); }
  .is-dark .tiles span:nth-child(odd) { background: var(--gold); color: var(--deep); }
  @media (max-width: 900px) { .area--rev .area__vis { order: 0; } .toc { top: 70px; } }

  /* Servicios y equipo: un bloque por cada punto */
  .sx { display: grid; grid-template-columns: repeat(6, 1fr); gap: .8rem; }
  .sx__t { border-radius: 22px; padding: 1.1rem 1.2rem; background: var(--white); box-shadow: 0 20px 40px -26px rgb(10 43 32 / .45); display: grid; gap: .45rem; align-content: start; opacity: 0; translate: 0 30px; transition: opacity .7s var(--ease), translate .7s var(--ease); transition-delay: calc(var(--k) * .12s); }
  .sx:global(.is-in) .sx__t { opacity: 1; translate: 0 0; }
  .sx__h { font: 600 .72rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .sx__t small { color: var(--muted); font-size: .85rem; }
  .sx__cat { grid-column: 1 / 7; position: relative; padding: 0; overflow: hidden; rotate: -1deg; }
  .sx__cat :global(img) { width: 100%; height: auto; display: block; }
  .sx__lab { position: absolute; z-index: 2; left: 34%; top: 6px; background: var(--lime); color: var(--deep); font-weight: 700; font-size: .8rem; padding: .45em .85em; border-radius: 99px; rotate: 3deg; }
  .sx__vis { grid-column: 1 / 3; background: var(--green); } .sx__vis .sx__h, .sx__vis small { color: var(--on-dark); }
  .sx__sw { position: relative; display: grid; grid-template-columns: 1fr 1fr; background: rgb(255 255 255 / .1); border-radius: 12px; padding: 4px; font-weight: 700; font-size: .85rem; }
  .sx__sw span { position: relative; z-index: 1; text-align: center; padding: .45rem 0; color: var(--cream-l); animation: sw-a 5s infinite; }
  .sx__sw span:nth-child(2) { animation-name: sw-b; }
  .sx__sw i { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 9px; background: var(--lime); animation: sw-i 5s infinite cubic-bezier(.6, 0, .3, 1); }
  @keyframes sw-i { 0%, 42% { transform: none; } 50%, 92% { transform: translateX(100%); } 100% { transform: none; } }
  @keyframes sw-a { 0%, 42%, 100% { color: var(--deep); } 50%, 92% { color: var(--cream-l); } }
  @keyframes sw-b { 0%, 42%, 100% { color: var(--cream-l); } 50%, 92% { color: var(--deep); } }
  .sx__team { grid-column: 3 / 7; }
  .sx__team ul { list-style: none; display: grid; gap: .4rem; }
  .sx__team li { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; font-size: .88rem; }
  .sx__team b { color: var(--green); margin-right: .2rem; }
  .sx__team em { font-style: normal; background: rgb(15 61 46 / .07); color: var(--green); padding: .25em .6em; border-radius: 8px; font-size: .8rem; font-weight: 600; }
  .sx__team em.sx__off { background: rgb(200 182 255 / .45); color: var(--deep); }
  .sx__fest em { background: var(--lime); color: var(--deep); }
  .sx__av { width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center; background: var(--green); color: var(--lime); font-weight: 700; font-size: .8rem; }
  .sx__av--2 { background: var(--lilac); color: var(--deep); } .sx__av--3 { background: var(--cream); color: var(--green); font-size: .7rem; }
  .sx__add { justify-self: start; margin-top: .2rem; font-weight: 700; font-size: .85rem; color: var(--deep); background: var(--lime); padding: .4em .8em; border-radius: 99px; }
  @media (max-width: 640px) { .sx { grid-template-columns: 1fr; } .sx__t { grid-column: 1 / -1 !important; } }
  @media (prefers-reduced-motion: reduce) { .sx__t { opacity: 1; translate: none; } .sx__sw span, .sx__sw i { animation: none; } .sx__sw span:first-child { color: var(--deep); } }

  /* Clientes: ficha recreada por bloques */
  .cx__head { grid-column: 1 / 7; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; background: var(--cream-l); }
  .cx__av { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; background: var(--lilac); color: var(--deep); font-weight: 700; rotate: -5deg; }
  .cx__name { display: block; font-size: 1.25rem; color: var(--green); letter-spacing: -.02em; }
  .cx__tags { display: flex; gap: .35rem; margin-top: .3rem; }
  .cx__tags em { font-style: normal; font-size: .76rem; font-weight: 700; padding: .3em .7em; border-radius: 99px; background: var(--lime); color: var(--deep); }
  .cx__tags .cx__t2 { background: var(--lilac); }
  .cx__kpi { list-style: none; display: flex; gap: 1.1rem; }
  .cx__kpi li { display: grid; font-size: .75rem; color: var(--muted); text-align: center; }
  .cx__kpi b { font-size: 1.35rem; color: var(--green); letter-spacing: -.03em; }
