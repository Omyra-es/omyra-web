---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Phone from '../components/Phone.astro';
import Shot from '../components/Shot.astro';
import Toast from '../components/Toast.astro';
import Marquee from '../components/Marquee.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import LockScreen from '../components/LockScreen.astro';
import Photo from '../components/Photo.astro';
import HeroReel from '../components/HeroReel.astro';
import Frag from '../components/Frag.astro';
import BookingFlow from '../components/BookingFlow.astro';
import fAgenda from '../assets/frag/agenda-columnas.jpg';
import fIndic from '../assets/frag/agenda-indicadores.jpg';
import fAviso from '../assets/frag/aviso-app.jpg';
import fFichaHead from '../assets/frag/ficha-cabecera.jpg';
import fHabitos from '../assets/frag/ficha-habitos.jpg';
import fNotas from '../assets/frag/ficha-notas.jpg';
import fDocRow from '../assets/frag/doc-consentimiento.jpg';
import fDocAuto from '../assets/frag/doc-firma-auto.jpg';
import fPagos from '../assets/frag/pagos-opciones.jpg';
import fServ from '../assets/frag/servicios-columnas.jpg';
import fServDet from '../assets/frag/servicio-detalles.jpg';
import fWa from '../assets/frag/whatsapp-atencion.jpg';

import { cta, site } from '../content/site';
import { pricing } from '../content/pricing';
import { sectors } from '../content/sectors';
import { pick } from '../content/faq';

import reservaServicio from '../assets/luna/reserva-2-servicio.jpg';
import reservaInicio from '../assets/luna/reserva-1-inicio.jpg';
import reservaProf from '../assets/luna/reserva-3-profesional.jpg';
import reservaPaso1 from '../assets/luna/reserva-paso1.jpg';
import { Image } from 'astro:assets';
import reservaFecha from '../assets/luna/reserva-4-fecha.jpg';
import reservaOk from '../assets/luna/reserva-7-confirmada.jpg';
import agendaDia from '../assets/producto/agenda-dia.jpg';
import servicios from '../assets/producto/servicios.jpg';
import documentos from '../assets/producto/documentos.jpg';
import clienteFicha from '../assets/producto/cliente-ficha.jpg';
import clienteNotas from '../assets/producto/cliente-notas.jpg';
import pagosSenales from '../assets/producto/pagos-senales.jpg';
import waAtencion from '../assets/producto/whatsapp-atencion.jpg';
import bonoModal from '../assets/producto/bono-modal.jpg';
import promoModal from '../assets/producto/promo-modal.jpg';
import informePref from '../assets/producto/informe-preferencias.jpg';
import agendaMovil from '../assets/producto/movil-agenda-dia.png';
import fichaMovil from '../assets/producto/movil-cliente-ficha.png';

const faqs = pick('negocios', 'precio', 'marketplace', 'comisiones', 'facturacion', 'whatsapp');
const description = 'Omyra es el software de reservas online y gestión de citas para negocios con cita previa: tu propia página de reservas, agenda del equipo, clientes, pagos, bonos y facturación. 29,90 € + IVA al mes.';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Omyra', url: site.url, email: site.contact.email, telephone: site.contact.phone, address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' } },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Omyra', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description, offers: { '@type': 'Offer', price: pricing.amountNumber.toFixed(2), priceCurrency: pricing.currencyCode, priceSpecification: { '@type': 'UnitPriceSpecification', price: pricing.amountNumber.toFixed(2), priceCurrency: pricing.currencyCode, valueAddedTaxIncluded: false, unitText: 'MONTH' } } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const problems = [
  { n: '4 canales', t: 'Una llamada, un WhatsApp, un mensaje por redes sociales y alguien que pasa por el mostrador. Y tú, cuadrando huecos a mano.', tone: 'green' },
  { n: 'Turnos', t: 'Horarios distintos, ausencias y festivos de todo el equipo en la cabeza de una sola persona.', tone: 'cream' },
  { n: 'Mil preguntas', t: '«¿Vengo en ayunas?», «¿sin maquillaje?», «¿traigo mis informes?». Tus clientes te escriben antes de cada cita para saber cómo prepararse.', tone: 'gold' },
  { n: 'Lo importante, perdido', t: 'Notas en una libreta, consentimientos en una carpeta y bonos en una hoja de cálculo. Nunca está a mano cuando lo necesitas.', tone: 'deep' },
];
---
<Base title="Omyra · Software de reservas online y gestión de citas para tu negocio" description={description} jsonld={jsonld}>

  <!-- 1 · HERO -->
  <section class="hero is-dark">
    <h1 class="hero__h1">
      <span class="hero__l"><span class="w" style="--i:0">Tú</span> <span class="w" style="--i:1">trabajas.</span></span>
      <span class="hero__l hero__l--2"><span class="w" style="--i:2">Tus</span> <span class="w" style="--i:3">clientes</span> <span class="w hero__res" style="--i:4">reservan.</span></span>
    </h1>
    <div class="wrap hero__row">
      <div class="hero__text">
        <p class="eyebrow hero__eb">Para negocios que trabajan con citas</p>
        <p class="lead hero__lead">Organiza tu agenda, gestiona tus servicios y deja que tus clientes reserven online. Todo tu negocio, más organizado.</p>
        <div class="hero__ctas">
          <Button href={cta.demo.href} size="lg" arrow class="btn--block-sm">{cta.demo.label}</Button>
          <Button href={cta.discover.href} variant="ghost" size="lg" class="btn--block-sm">{cta.discover.label}</Button>
        </div>
        <ul class="hero__trust" role="list">
          <li><b>{pricing.amount} €</b> {pricing.tax} {pricing.period}</li><li>Sin permanencia</li><li>Sin comisiones por reserva</li><li>Profesionales ilimitados sin coste adicional</li>
        </ul>
      </div>
      <HeroReel />
    </div>
  </section>

  <!-- 2 · SECTORES -->
  <Marquee />

  <!-- 3 · PROBLEMAS -->
  <section class="sec bg-light is-light">
    <div class="wrap">
      <p class="eyebrow reveal">El día a día de un negocio con citas</p>
      <h2 class="h2 balance mt-2 reveal probs__h">Las citas llegan por todas partes. <span class="probs__soft">Tu agenda no debería depender de tu memoria.</span></h2>
      <div class="probs">
        {problems.map((p, i) => (
          <article class:list={['prob', `prob--${p.tone}`, 'reveal']} style={`--d:${i * 0.08}s`}>
            <p class="prob__n">{p.n}</p><p class="prob__t">{p.t}</p>
          </article>
        ))}
      </div>
      <p class="lead mt-4 reveal">Omyra reúne las reservas, la agenda del equipo, los clientes y los cobros en un mismo panel, y te deja tiempo para lo que de verdad importa: tu trabajo.</p>
    </div>
  </section>

  <!-- 4 · CANAL PROPIO (diferenciación) -->
  <section class="sec bg-lime own">
    <div class="wrap">
      <p class="eyebrow reveal">No somos un marketplace</p>
      <h2 class="own__big reveal">
        <span>Tu marca.</span><span>Tus reservas.</span><span class="own__o"><span class="swipe" style="--swipe:var(--lilac)">Tus clientes.</span></span>
      </h2>
      <div class="vsx mt-5" data-in>
        <div class="vsx__head"><span>En un marketplace</span><span>Con Omyra</span></div>
        <ul class="vsx__rows" role="list">
          <li style="--k:0"><s>Tu negocio, al lado de la competencia</s><b>Solo tu negocio</b></li>
          <li style="--k:1"><s>La marca de la plataforma</s><b>Tu logo y tus colores</b></li>
          <li style="--k:2"><s>Tu cliente compara y se va</s><b>Tu cliente reserva contigo</b></li>
          <li style="--k:3"><s>Su enlace, su escaparate</s><b>Tu enlace, en tu Instagram, tu WhatsApp o tu web</b></li>
        </ul>
      </div>
      <div class="mt-4 reveal"><Button href="/reservas-online" variant="dark" arrow>Tu propio canal de reservas</Button></div>
    </div>
  </section>

  <!-- 4b · SECTORES -->
  <section class="sec bg-light is-light wall-sec">
    <div class="wrap">
      <p class="eyebrow reveal">Para negocios con citas</p>
      <h2 class="h2 balance mt-2 reveal">Cualquier negocio. <span class="gold-ink">Cualquier ritmo.</span></h2>
      <div class="wall mt-4">
        <Photo id="unas" class="wa1 reveal" sizes="(min-width: 900px) 34vw, 92vw" />
        <Photo id="pestanas" class="wa2 reveal" sizes="(min-width: 900px) 25vw, 46vw" />
        <Photo id="peluqueria" class="wa3 reveal" sizes="(min-width: 900px) 34vw, 46vw" />
        <Photo id="microblading" class="wa4 reveal" sizes="(min-width: 900px) 25vw, 46vw" />
        <Photo id="labios" class="wa5 reveal" sizes="(min-width: 900px) 25vw, 46vw" />
        <Photo id="westie" class="wa6 reveal" sizes="(min-width: 900px) 17vw, 46vw" />
        <Photo id="tatuaje" class="wa7 reveal" sizes="(min-width: 900px) 17vw, 46vw" />
        <Photo id="spa" class="wa8 reveal" sizes="(min-width: 900px) 17vw, 46vw" />
        <a class="wa9 reveal" href="/contacto"><span>¿Tu negocio trabaja con citas?</span><span class="wa9__go" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 5 · RESERVAS EN 3 PASOS -->
  <section class="sec bg-cream is-light book">
    <div class="wrap split split--wide-r">
      <div>
        <p class="eyebrow reveal">Reservas online</p>
        <h2 class="h2 balance mt-2 reveal">Reservar contigo, <span class="gold-ink">en tres pasos.</span></h2>
        <p class="lead mt-2 reveal">Tus clientes eligen servicio, profesional y hora, a cualquier hora del día. Tú decides qué se puede reservar online, con qué duración y a qué precio.</p>
        <ol class="steps mt-3" role="list">
          <li class="reveal"><i>1</i><span><b>Servicio</b>Con foto, descripción, duración y precio.</span></li>
          <li class="reveal" style="--d:.08s"><i>2</i><span><b>Profesional</b>Quien lo realiza, o «Cualquiera».</span></li>
          <li class="reveal" style="--d:.16s"><i>3</i><span><b>Fecha y hora</b>Solo los huecos libres de tu agenda.</span></li>
        </ol>
        <div class="mt-3 reveal"><Button href="/reservas-online" variant="green" arrow>Ver cómo reservan tus clientes</Button></div>
      </div>
      <BookingFlow />
    </div>
  </section>

  <!-- 6 · AGENDA Y EQUIPO -->
  <section class="sec bg-deep is-dark agenda">
    <div class="wrap split split--wide-r">
      <div class="agenda__text">
        <p class="eyebrow reveal">Agenda y equipo</p>
        <h2 class="h2 balance mt-2 reveal">Todo tu equipo, <span class="gold">en una sola agenda.</span></h2>
        <p class="lead mt-2 reveal">Mira el día, la semana o el mes. Cada profesional con sus citas, su horario y su ocupación. Sin llamadas para preguntar quién está libre.</p>
        <ul class="ring-list mt-3">
          <li class="reveal">Vista diaria, semanal y mensual</li>
          <li class="reveal">Horarios con dos turnos al día</li>
          <li class="reveal">Ausencias, vacaciones y festivos</li>
          <li class="reveal">Ocupación de cada profesional de un vistazo</li>
          <li class="reveal">Las citas, también en el Google Calendar de cada profesional</li>
        </ul>
      </div>
      <div class="agx" data-in>
        <Frag src={fIndic} alt="Indicadores del día en Omyra: citas, ocupación y profesionales" r="-1deg" class="agx__ind" />
        <Frag src={fAgenda} alt="Citas del día de cada profesional en la agenda de Omyra" r="0deg" class="agx__cal" />
        <Frag src={fAviso} alt="Aviso de nueva reserva online dentro de Omyra" r="2.5deg" class="agx__aviso" />
        <div class="gcal" aria-label="Las citas de Omyra aparecen en el Google Calendar de cada profesional">
          <span class="gcal__from">Omyra</span>
          <span class="gcal__line" aria-hidden="true"><i></i></span>
          <div class="gcal__card">
            <p class="gcal__app"><span class="gcal__ico" aria-hidden="true">31</span>Google Calendar</p>
            <p class="gcal__ev"><b>Lifting de pestañas</b><span>lun 16 nov · 18:00–19:00</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7 · SERVICIOS · INSTRUCCIONES · VALORACIÓN -->
  <section class="sec bg-light is-light">
    <div class="wrap">
      <div class="center-head">
        <p class="eyebrow reveal">Servicios</p>
        <h2 class="h2 balance mt-2 reveal">Cada servicio, <span class="gold-ink">bien explicado.</span></h2>
      </div>
      <div class="tabs mt-4" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Servicios">
          <button role="tab" id="t-cat" aria-controls="p-cat" aria-selected="true">Tu catálogo</button>
          <button role="tab" id="t-ins" aria-controls="p-ins" aria-selected="false">Antes de la cita</button>
          <button role="tab" id="t-val" aria-controls="p-val" aria-selected="false">Primera valoración</button>
          <span class="tabs__ink" aria-hidden="true"></span>
        </div>
        <div class="tabs__panel split split--wide-r" role="tabpanel" id="p-cat" aria-labelledby="t-cat">
          <div><h3 class="h3">Tu catálogo, claro y atractivo.</h3><p class="lead mt-1">Organiza tus servicios por categorías, con foto, descripción, duración y precio. Decide cuáles se reservan online y cuáles son solo internos.</p></div>
          <div class="servx" data-in>
            <Frag src={fServ} alt="Servicios en Omyra con foto, descripción, duración y precio" r="-1.5deg" z={1} sizes="(min-width: 900px) 46vw, 92vw" />
            <span class="sticker servx__s">Reserva online · Sí</span>
          </div>
        </div>
        <div class="tabs__panel split split--wide-r" role="tabpanel" id="p-ins" aria-labelledby="t-ins" hidden>
          <div><h3 class="h3">Que lleguen preparados.</h3><p class="lead mt-1">Añade a cada servicio sus indicaciones previas, en texto o como documento, y tus clientes las reciben por correo antes de la cita.</p></div>
          <div class="mail" aria-label="Ejemplos de indicaciones previas">
            <p class="caption">Ejemplos de indicaciones</p>
            <ul role="list">
              <li><b>Fisioterapia</b>Ven con ropa cómoda y trae tus informes.</li>
              <li><b>Lifting de pestañas</b>Acude sin maquillaje ni rímel.</li>
              <li><b>Masaje</b>Llega diez minutos antes para empezar a tu hora.</li>
              <li><b>Tatuaje</b>Ven hidratado y descansado.</li>
            </ul>
          </div>
        </div>
        <div class="tabs__panel split split--wide-r" role="tabpanel" id="p-val" aria-labelledby="t-val" hidden>
          <div><h3 class="h3">Hay trabajos que empiezan con una conversación.</h3><p class="lead mt-1">Ofrece una cita de valoración, gratuita o de pago, como un servicio más. Tu equipo conoce lo que necesita cada cliente y después planificáis juntos el trabajo.</p></div>
          <div class="val">
            <div class="val__steps" aria-hidden="true"><span class="sticker" style="background:var(--lilac)">20 oct · Evaluación previa · Gratis</span><span class="sticker" style="background:var(--lime)">10 nov · Balayage · 300,00 €</span></div>
            <figure class="note">
              <p class="note__h">Notas internas</p>
              <blockquote>Busca reflejos miel y un balayage con raíz difuminada, sin contrastes excesivos. <mark>Evaluación realizada el 20/10. Presupuesto personalizado aceptado: 300 €.</mark></blockquote>
              <p class="note__f">Solo visible para tu equipo</p>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 · PAGOS -->
  <section class="sec bg-green is-dark pay">
    <div class="wrap">
      <p class="eyebrow reveal">Pagos y señales</p>
      <h2 class="h2 balance mt-2 reveal">Cobra como <span class="mark">trabaja tu negocio.</span></h2>
      <p class="lead mt-2 reveal">Pide una señal en los servicios que lo necesitan, o deja que paguen en tu negocio. Y registra cada cobro para tenerlo todo cuadrado al final del día.</p>
      <div class="lanes mt-4">
        <div class="lane lane--lilac reveal" data-in>
          <h3 class="lane__h">Bizum o transferencia <span class="chip">Tú confirmas</span></h3>
          <ol class="lane__steps" role="list">
            <li>El cliente reserva y paga la señal</li>
            <li>La cita queda pendiente</li>
            <li class="you">Compruebas el pago y marcas «Pago recibido»</li>
            <li class="ok">La cita queda confirmada</li>
          </ol>
          <p class="lane__note">Si vence el plazo sin pago, la cita se cancela y el hueco se libera.</p>
        </div>
        <div class="lane lane--lime reveal" data-in style="--d:.1s">
          <h3 class="lane__h">Stripe <span class="chip">Se activa</span></h3>
          <ol class="lane__steps" role="list">
            <li>El cliente paga con tarjeta al reservar</li>
            <li class="ok">Stripe valida el pago</li>
          </ol>
          <p class="lane__note">Stripe aplica sus propias tarifas. Omyra no cobra comisiones.</p>
        </div>
        <div class="lane lane--reg reveal" data-in style="--d:.2s">
          <h3 class="lane__h">Registro de cobros</h3>
          <div class="methods"><span>Efectivo</span><span>Tarjeta</span><span>Bizum</span><span>Transferencia</span><span>Bono</span></div>
          <p class="lane__note">Al completar la cita registras cómo se ha pagado, también si es una sesión de su bono, y lo ves en el informe del día.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · AVISOS Y WHATSAPP -->
  <section class="sec bg-lilac wa">
    <div class="wrap split split--wide-r">
      <div class="reveal"><LockScreen /></div>
      <div>
        <p class="eyebrow reveal">Avisos</p>
        <h2 class="h2 balance mt-2 reveal">Aunque no estés en la app de Omyra, <span class="swipe" style="--swipe:var(--lime)">te enteras.</span></h2>
        <p class="lead mt-2 reveal">Cada nueva reserva online llega como aviso a tu móvil, con el día, la hora, el servicio, el profesional y el cliente. Tu cliente recibe al momento el correo de confirmación con el nombre de tu negocio. Y si tu equipo usa Google Calendar, cada profesional ve allí sus citas de Omyra.</p>
      </div>
    </div>
    <div class="wrap wa__row mt-5">
      <div class="wa__bot reveal">
        <span class="wa__ico" aria-hidden="true"><svg viewBox="0 0 32 32" width="34" height="34"><path fill="currentColor" d="M16 3.2A12.8 12.8 0 0 0 5 22.5L3.3 28.7l6.4-1.7A12.8 12.8 0 1 0 16 3.2Zm0 23.3c-2 0-3.9-.6-5.5-1.6l-.4-.2-3.8 1 1-3.7-.3-.4A10.5 10.5 0 1 1 16 26.5Zm5.8-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-4.3-3.7c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.2 1.3 3.4c.2.2 2.3 3.5 5.6 4.9 2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.4Z"/></svg></span>
        <p class="eyebrow">Asistente de WhatsApp</p>
        <h3 class="h3 mt-1">Un asistente de citas en tu WhatsApp.</h3>
        <p class="mt-1 text-2">Conecta el WhatsApp Business de tu negocio y deja que el asistente atienda las solicitudes de cita. Tú eliges si responde solo a clientes registrados o a cualquier número.</p>
        <div class="wa__split mt-2">
          <div class="wa__box wa__box--bot"><b>¿Quiere una cita?</b><span>El asistente le ayuda a reservar con las reglas de tu agenda.</span></div>
          <div class="wa__box"><b>¿Otra consulta?</b><span>En tu dashboard aparece una alerta de mensajes que requieren tu atención, y la respondes tú desde WhatsApp Business. No se te escapa nada.</span></div>
        </div>
      </div>
      <div class="chat" aria-hidden="true">
        <div class="chat__top"><span class="chat__av">L</span><span><b>Luna Studio</b><small>WhatsApp Business</small></span></div>
        <div class="chat__body">
          <p class="msg msg--in" style="--s:0">Hola, quería pedir cita para un lifting de pestañas 😊</p>
          <p class="msg msg--out" style="--s:1">¡Hola! Te ayudo a reservar. ¿Qué día te viene mejor?</p>
          <p class="msg msg--in" style="--s:2">¿Puedo ir con las pestañas teñidas?</p>
          <p class="chat__alert" style="--s:3"><i>!</i> Mensajes que requieren tu atención</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 · CLIENTES -->
  <section class="sec bg-light is-light docs">
    <div class="wrap split split--wide-r">
      <div>
        <p class="eyebrow reveal">Ficha de cliente</p>
        <h2 class="h2 balance mt-2 reveal">Cada cliente, <span class="gold-ink">con su historia.</span></h2>
        <p class="lead mt-2 reveal">Abre su ficha y lo tienes todo: citas completadas, gasto, última visita, hábitos, segmentos y tus notas internas. Y desde ahí le escribes por WhatsApp o por correo.</p>
        <ul class="ring-list mt-3">
          <li class="reveal">Historial de citas y gasto total</li>
          <li class="reveal">Hábitos: frecuencia media y ticket medio</li>
          <li class="reveal">Segmentos como «Habitual» o «Alto gasto»</li>
          <li class="reveal">Notas internas, solo visibles para tu equipo</li>
        </ul>
      </div>
      <div class="fx" data-in>
        <Frag src={fFichaHead} alt="Cabecera de la ficha de una clienta en Omyra: citas completadas, gasto total, última visita y próxima cita" r="-1deg" class="fx__head" />
        <div class="fx__row" data-in>
          <Frag src={fHabitos} alt="Segmentos y hábitos de una clienta en Omyra" r="1deg" class="fx__hab" />
          <div class="fx__stats" aria-hidden="true">
            <p><b>2</b><span>citas completadas</span></p>
            <p><b>300 €</b><span>gasto total</span></p>
            <p><b>Cada 3 semanas</b><span>frecuencia media</span></p>
          </div>
        </div>
        <span class="sticker fx__s" style="background:var(--lilac)">Habitual · Alto gasto</span>
      </div>
    </div>
  </section>

  <!-- 10b · FIRMAS -->
  <section class="sec bg-lilac sign">
    <div class="wrap split split--wide-l">
      <div class="mailflow" data-in aria-label="Correo de confirmación de la cita con el botón para revisar y firmar el consentimiento">
        <div class="mailx">
          <p class="mailx__from"><b>Tu negocio</b> · vía Omyra</p>
