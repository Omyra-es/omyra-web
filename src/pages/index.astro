  .bill__flow::before { content: ''; position: absolute; left: 2rem; right: 2rem; top: 2.15rem; height: 2px; background: linear-gradient(90deg, var(--gold), rgb(215 243 107 / .2)); }
  .bill__flow li { position: relative; display: grid; gap: .6rem; align-content: start; padding: 1.6rem; border-radius: var(--r-lg); background: rgb(247 245 241 / .04); box-shadow: inset 0 0 0 1px var(--line-dark); }
  .bill__n { width: 64px; height: 40px; border-radius: 10px; transform: skewX(-10deg); display: grid; place-items: center; background: var(--deep); border: 2px solid var(--gold); color: var(--gold); font: 600 .9rem/1 var(--mono); position: relative; margin-top: -1.6rem; }
  .bill__flow b { font-size: 1.3rem; letter-spacing: -.02em; }
  .bill__flow li > span:last-child { color: var(--on-dark); font-size: .97rem; }

  /* INFORMES */
  .reports__vis { position: relative; }
  .reports__s { position: absolute; left: -1rem; top: -1rem; color: var(--deep); rotate: -5deg; }

  /* MÓVIL */
  .mob__phones { display: flex; gap: 1.5rem; justify-content: center; align-items: flex-start; }
  :global(.mob__p2) { margin-top: 4rem; }

  /* PRECIO · cifra gigante */
  .price { overflow: hidden; }
  .price__big { font-size: clamp(5.5rem, 2rem + 24vw, 25rem); line-height: .76; padding-bottom: .2em; letter-spacing: -.08em; font-weight: 600; color: var(--lime); white-space: nowrap; margin-top: 1.5rem; }
  .price__big sup { font-size: .24em; color: var(--cream-l); vertical-align: top; position: relative; top: .3em; margin-left: .05em; }
  .price__chips { list-style: none; display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.4rem; position: relative; z-index: 1; }
  .price__chips li { padding: .75rem 1.15rem; border-radius: 99px; background: rgb(247 245 241 / .08); font-weight: 600; }
  .price__chips li:nth-child(3n+1) { background: var(--lilac); color: var(--deep); }
  .price__note { font-size: .9rem; color: var(--on-dark); margin-top: 1.5rem; max-width: 46em; }
  .price__ctas { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; }
  .price__more { color: var(--lime); font-weight: 600; }

  /* FAQ */
  .faqs { align-items: start; }

  /* RESPONSIVE */
  @media (max-width: 1100px) { .lanes { grid-template-columns: 1fr 1fr; } .lane--reg { grid-column: 1 / -1; } .bill__flow { grid-template-columns: 1fr 1fr; } .bill__flow::before { display: none; } }
  @media (max-width: 900px) {
    .hero__l--2 { padding-left: 0; }
    .hero__row { grid-template-columns: 1fr; gap: .5rem; }
    .hero__text { padding-bottom: 1rem; }
    .collage :global(.col__phone) { --pw: 150px; bottom: -70px; }
    .col__s2 { right: 4%; top: 20%; }
    .own__grid { grid-template-columns: 1fr; gap: 2rem; } .own__points { grid-template-columns: 1fr; }
    .own__big span:nth-child(2) { padding-left: 6vw; } .own__big .own__o { padding-left: 12vw; }
    .wall { grid-auto-rows: 84px; }
    .wall :global(.w1) { grid-column: 1 / 8; grid-row: 1 / 3; } .wall :global(.w2) { grid-column: 8 / 13; grid-row: 1 / 3; }
    .wall :global(.w3) { grid-column: 1 / 13; grid-row: 3 / 5; }
    .wall :global(.w4) { grid-column: 1 / 7; grid-row: 5 / 7; } .wall :global(.w5) { grid-column: 7 / 13; grid-row: 5 / 7; }
    .w6 { grid-column: 1 / 13; grid-row: 7 / 8; } .w7 { grid-column: 1 / 13; grid-row: 8 / 9; }
    .probs { grid-template-columns: 1fr; } .prob--green, .prob--cream, .prob--gold, .prob--deep { grid-column: auto; min-height: 0; }
    .book__phones { height: auto; margin-top: 1.5rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; } :global(.book__p1), :global(.book__p2) { --pw: min(44%, 230px); } .book__phones :global(.book__p2) { margin-top: 2.5rem; }
    .agenda__vis { margin-top: 1.5rem; } .s1 { left: .5rem; bottom: -1.5rem; } .s2 { right: .5rem; }
    .val { grid-template-columns: 1fr; } .val__arrow { rotate: 90deg; justify-self: center; }
    .docs__c1 { left: .5rem; top: auto; bottom: -1rem; } .docs__c2 { display: none; }
    .wa__grid { grid-template-columns: 1fr; } .wa__shot { max-width: 300px; }
    .promo__cards { height: auto; display: grid; gap: 1rem; } .promo__a, .promo__b { position: static; width: 100%; } .promo__s { top: -1rem; }

    .mob__phones :global(.phone) { --pw: 46%; }
    :global(.mob__p2) { margin-top: 2.5rem; }
  }
  @media (max-width: 640px) {
    .lanes, .bill__flow { grid-template-columns: 1fr; }
    .wa__split { grid-template-columns: 1fr; }
    .tabs__list { margin-inline: 0; }
    .tabs__list button { padding: .7rem 1rem; font-size: .92rem; }
  }

  /* ===== Rediseño de secciones (v4) ===== */
  /* No marketplace: comparación animada */
  .vsx { border-top: 2px solid var(--deep); }
  .vsx__head { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: 1rem 0; font: 500 .78rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--deep); }
  .vsx__rows { list-style: none; display: grid; gap: .7rem; }
  .vsx__rows li { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: center; }
  .vsx__rows s, .vsx__rows b { padding: 1rem 1.3rem; border-radius: 18px; font-size: clamp(1rem, .9rem + .6vw, 1.35rem); letter-spacing: -.02em; transition: all .7s var(--ease); transition-delay: calc(var(--k) * .18s); }
  .vsx__rows s { text-decoration: none; background: rgb(10 43 32 / .07); color: rgb(10 43 32 / .55); position: relative; }
  .vsx__rows s::after { content: ''; position: absolute; left: 1.3rem; right: 1.3rem; top: 50%; height: 2px; background: rgb(10 43 32 / .55); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease); transition-delay: calc(var(--k) * .18s + .4s); }
  .vsx__rows b { background: var(--deep); color: var(--lime); font-weight: 600; transform: translateX(-24px); opacity: 0; }
  .vsx:global(.is-in) .vsx__rows s::after { transform: scaleX(1); }
  .vsx:global(.is-in) .vsx__rows b { transform: none; opacity: 1; }
  .vsx__rows li:nth-child(even) b { background: var(--lilac); color: var(--deep); }

  /* Sectores con peso en belleza */
  .wall { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: clamp(80px, 7.5vw, 112px); gap: 12px; }
  .wall :global(.wa1) { grid-column: 1 / 6; grid-row: 1 / 5; }
  .wall :global(.wa2) { grid-column: 6 / 9; grid-row: 1 / 3; }
  .wall :global(.wa3) { grid-column: 9 / 13; grid-row: 1 / 4; }
  .wall :global(.wa4) { grid-column: 6 / 9; grid-row: 3 / 5; }
  .wall :global(.wa5) { grid-column: 9 / 13; grid-row: 4 / 6; }
  .wall :global(.wa6) { grid-column: 1 / 3; grid-row: 5 / 7; }
  .wall :global(.wa7) { grid-column: 3 / 6; grid-row: 5 / 7; }
  .wall :global(.wa8) { grid-column: 6 / 9; grid-row: 5 / 7; }
  .wa9 { grid-column: 9 / 13; grid-row: 6 / 7; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 1.4rem; border-radius: 24px; background: var(--lilac); color: var(--deep); font-weight: 700; font-size: clamp(1rem, .9rem + .4vw, 1.25rem); letter-spacing: -.02em; text-decoration: none; transition: transform .3s var(--ease); }
  .wa9__go { flex: none; width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; background: var(--deep); color: var(--lime); font-size: 1.3rem; transition: transform .3s var(--ease); }
  .wa9:hover { transform: translateY(-3px); } .wa9:hover .wa9__go { transform: translateX(4px) rotate(-6deg); }

  /* Reservas: tres pasos */
  .book__phones :global(.book__p0) { rotate: -6deg; }
  .book__phones :global(.book__p1) { rotate: 0deg; margin-top: 3rem; }
  .book__phones :global(.book__p2) { rotate: 6deg; margin-top: 6rem; }
  .book__phones { gap: .4rem; flex-wrap: nowrap; }

  /* Agenda + Google Calendar */
  .agx { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; align-items: start; }
  .agx :global(.agx__ind) { grid-column: 1 / 13; grid-row: 1; }
  .agx :global(.agx__cal) { grid-column: 1 / 10; grid-row: 2 / 4; }
  .agx :global(.agx__aviso) { grid-column: 8 / 13; grid-row: 3; margin-top: -40%; z-index: 3; }
  .gcal { grid-column: 3 / 13; grid-row: 4; display: flex; align-items: center; gap: .8rem; margin-top: .4rem; }
  .gcal__from { flex: none; font-weight: 700; padding: .55rem 1rem; border-radius: 99px; background: var(--lime); color: var(--deep); }
  .gcal__line { flex: 1; height: 2px; background: repeating-linear-gradient(90deg, var(--lime) 0 8px, transparent 8px 14px); position: relative; overflow: visible; }
  .gcal__line i { position: absolute; top: -5px; left: 0; width: 12px; height: 12px; border-radius: 3px; background: var(--lilac); animation: gcal-move 2.6s ease-in-out infinite; }
  @keyframes gcal-move { 0% { left: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { left: calc(100% - 12px); opacity: 0; } }
  .gcal__card { flex: none; background: #fff; color: var(--ink); border-radius: 18px; padding: .9rem 1.1rem; box-shadow: var(--shadow); min-width: 230px; rotate: 2deg; }
  .gcal__app { display: flex; align-items: center; gap: .55rem; font-weight: 700; font-size: .92rem; }
  .gcal__ico { width: 30px; height: 30px; border-radius: 8px; display: grid; place-items: center; font: 700 .8rem/1 var(--font); color: #fff; background: #4285F4; }
  .gcal__ev { margin-top: .6rem; padding: .55rem .8rem; border-left: 4px solid #4285F4; border-radius: 6px; background: #E8F0FE; display: grid; font-size: .85rem; }
  .gcal__ev span { color: var(--muted); }

  /* Valoración: nota legible */
  .note { margin: 0; background: #fff; border-radius: var(--r-lg); padding: clamp(1.4rem, 1rem + 1.5vw, 2.2rem); box-shadow: var(--shadow); max-width: 34rem; rotate: -1deg; }
  .note__h { font: 500 .75rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .note blockquote { margin-top: 1rem; font-size: clamp(1.1rem, 1rem + .5vw, 1.4rem); line-height: 1.45; letter-spacing: -.01em; color: var(--ink); }
  .note mark { background: linear-gradient(transparent 55%, var(--lime) 55%); color: inherit; padding-inline: .1em; }
  .note__f { margin-top: 1rem; font-size: .85rem; color: var(--muted); }

  /* Pagos con color */
  .lane--lilac { background: var(--lilac); color: var(--deep); box-shadow: none; }
  .lane--lime { background: var(--lime); color: var(--deep); box-shadow: none; }
  .lane--lilac .lane__note, .lane--lime .lane__note { color: rgb(10 43 32 / .75); }
  .lane--lilac .chip, .lane--lime .chip { background: var(--deep); color: var(--cream-l); }
  .lane--lilac .lane__steps li, .lane--lime .lane__steps li { background: rgb(255 255 255 / .45); }
  .lane--lilac .lane__steps li::before, .lane--lime .lane__steps li::before { background: rgb(10 43 32 / .12); }
  .lane--lilac .lane__steps li.you { background: #fff; box-shadow: inset 0 0 0 2px var(--deep); }
  .lane--lilac .lane__steps li.you::before, .lane--lilac .lane__steps li.ok::before, .lane--lime .lane__steps li.ok::before { background: var(--deep); color: var(--lime); }

  /* Ficha: composición ordenada */
  .fx { position: relative; display: grid; gap: 14px; }
  .fx__row { display: grid; grid-template-columns: 1.2fr .8fr; gap: 14px; align-items: center; }
  .fx__stats { display: grid; gap: .7rem; }
  .fx__stats p { background: var(--green); color: var(--cream-l); border-radius: 18px; padding: .9rem 1.1rem; display: grid; line-height: 1.15; }
  .fx__stats p:nth-child(2) { background: var(--lime); color: var(--deep); rotate: 1.5deg; }
  .fx__stats p:nth-child(3) { background: var(--lilac); color: var(--deep); rotate: -1.5deg; }
  .fx__stats b { font-size: 1.4rem; letter-spacing: -.03em; }
  .fx__stats span { font-size: .85rem; opacity: .8; }
  .fx__s { position: absolute; right: -1rem; top: -1.4rem; color: var(--deep); rotate: 5deg; z-index: 5; }

  /* Firmas: correo con botón y sello */
  .mailflow { position: relative; display: grid; justify-items: center; padding: 1rem; }
  .mailx { background: #fff; color: var(--ink); border-radius: var(--r-lg); padding: 1.8rem; width: min(420px, 100%); box-shadow: var(--shadow); rotate: -2deg; display: grid; gap: .5rem; }
  .mailx__from { font-size: .85rem; color: var(--muted); }
  .mailx__subj { font-size: 1.5rem; font-weight: 700; letter-spacing: -.03em; color: var(--green); }
  .mailx__body { color: var(--muted); }
  .mailx__doc { margin-top: .6rem; padding: .9rem 1rem; border-radius: 14px; background: var(--cream-l); }
  .mailx__btn { justify-self: start; margin-top: .4rem; background: var(--green); color: var(--lime); font-weight: 700; padding: .8rem 1.3rem; border-radius: 99px; animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 10px rgb(215 243 107 / .45); } }
  .stamp { position: absolute; right: 6%; bottom: 8%; font: 800 1.6rem/1 var(--font); letter-spacing: -.02em; color: var(--deep); background: var(--lime); padding: .7rem 1.2rem; border-radius: 14px; border: 3px solid var(--deep); rotate: -10deg; scale: 0; transition: scale .5s 1s cubic-bezier(.3,1.6,.5,1); }
  .mailflow:global(.is-in) .stamp { scale: 1; }

  /* Bonos: de papel a digital */

  /* Informes: resumen animado */
  .digest { background: #fff; color: var(--ink); border-radius: var(--r-lg); padding: clamp(1.4rem, 1rem + 1.5vw, 2.2rem); box-shadow: var(--shadow); rotate: 1.5deg; max-width: 30rem; justify-self: center; width: 100%; }
  .digest__h { display: flex; justify-content: space-between; font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; }
  .digest__h span:last-child { font: 500 .8rem/1.6 var(--mono); color: var(--muted); }
  .digest__kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-top: 1.2rem; }
  .digest__kpis p { border-radius: 16px; padding: .8rem; background: var(--cream-l); display: grid; }
  .digest__kpis p:nth-child(1) { background: var(--green); color: var(--lime); }
  .digest__kpis p:nth-child(2) { background: var(--lilac); }
  .digest__kpis b { font-size: 1.8rem; letter-spacing: -.04em; line-height: 1; }
  .digest__kpis span { font-size: .8rem; opacity: .8; }
  .digest__t { margin-top: 1.4rem; font: 500 .72rem/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .digest__bars { list-style: none; display: grid; gap: .55rem; margin-top: .8rem; }
  .digest__bars li { display: grid; grid-template-columns: 7rem 1fr; align-items: center; gap: .8rem; font-size: .9rem; }
  .digest__bars i { height: 12px; border-radius: 99px; background: var(--green); transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease); width: calc(var(--v) * 100%); }
  .digest__bars li:nth-child(2) i { background: var(--lime); } .digest__bars li:nth-child(3) i { background: var(--lilac); } .digest__bars li:nth-child(4) i { background: var(--gold-ink); }
  .digest:global(.is-in) .digest__bars i { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) { .vsx__rows b { opacity: 1; transform: none; } .vsx__rows s::after { transform: scaleX(1); } .stamp { scale: 1; } .digest__bars i { transform: none; } }
  @media (max-width: 900px) {
    .wall { grid-auto-rows: 86px; }
    .wall :global(.wa1) { grid-column: 1 / 13; grid-row: 1 / 4; } .wall :global(.wa2) { grid-column: 1 / 7; grid-row: 4 / 6; } .wall :global(.wa3) { grid-column: 7 / 13; grid-row: 4 / 6; }
    .wall :global(.wa4) { grid-column: 1 / 7; grid-row: 6 / 8; } .wall :global(.wa5) { grid-column: 7 / 13; grid-row: 6 / 8; } .wall :global(.wa6) { grid-column: 1 / 5; grid-row: 8 / 10; }
    .wall :global(.wa7) { grid-column: 5 / 9; grid-row: 8 / 10; } .wall :global(.wa8) { grid-column: 9 / 13; grid-row: 8 / 10; } .wa9 { grid-column: 1 / 13; grid-row: 10 / 11; }
    .vsx__rows li, .vsx__head { grid-template-columns: 1fr; gap: .35rem; } .vsx__head span:first-child { display: none; } .vsx__rows s { font-size: .95rem; padding: .6rem 1rem; }
    .book__phones { flex-wrap: nowrap; } .book__phones :global(.phone) { --pw: 32%; }
    .agx :global(.agx__cal) { grid-column: 1 / 13; } .agx :global(.agx__aviso) { grid-column: 3 / 13; grid-row: 4; margin-top: -2rem; } .gcal { grid-column: 1 / 13; grid-row: 5; } .gcal__card { min-width: 0; }
    .fx__row { grid-template-columns: 1fr; } .fx__s { right: 0; }
  }
  /* ===== v5 ===== */
  /* Servicios: solo servicio, duración y precio */
  .servx { position: relative; padding: 1rem 0 2rem; }
  .servx__s { position: absolute; right: -.5rem; bottom: .4rem; z-index: 3; rotate: 4deg; background: var(--lime); color: var(--deep); }

  /* WhatsApp */
  .wa__row { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(1.2rem, 3vw, 3rem); align-items: center; }
  .wa__bot { position: relative; }
  .wa__ico { position: absolute; top: -26px; right: 26px; width: 64px; height: 64px; border-radius: 20px; display: grid; place-items: center; background: #25D366; color: #fff; rotate: 8deg; box-shadow: 0 16px 30px -12px rgb(10 43 32 / .5); animation: wa-bob 3.2s ease-in-out infinite; }
  .wa__ico::after { content: ''; position: absolute; inset: 0; border-radius: inherit; border: 3px solid #25D366; animation: wa-ping 2.4s ease-out infinite; }
  @keyframes wa-bob { 0%, 100% { translate: 0 0; rotate: 8deg; } 50% { translate: 0 -8px; rotate: -4deg; } }
  @keyframes wa-ping { 0% { opacity: .8; scale: 1; } 80%, 100% { opacity: 0; scale: 1.6; } }
  .wa__split { grid-template-columns: 1fr 1fr; }
  .chat { background: #ECE5DA; border-radius: 30px; overflow: hidden; box-shadow: 0 30px 60px -28px rgb(10 43 32 / .5); rotate: 2deg; }
  .chat__top { display: flex; gap: .7rem; align-items: center; background: var(--deep); color: var(--cream-l); padding: .9rem 1.1rem; }
  .chat__top b { display: block; font-size: .95rem; } .chat__top small { color: var(--on-dark); font-size: .75rem; }
  .chat__av { width: 36px; height: 36px; border-radius: 11px; background: var(--lilac); color: var(--deep); display: grid; place-items: center; font-weight: 700; }
  .chat__body { display: grid; gap: .6rem; padding: 1.2rem 1rem 1.4rem; min-height: 300px; align-content: start; }
  .msg { max-width: 82%; padding: .65rem .9rem; border-radius: 16px; font-size: .92rem; line-height: 1.35; box-shadow: 0 2px 0 rgb(0 0 0 / .05); opacity: 0; animation: chat-in 12s calc(var(--s) * 1.6s) infinite; }
  .msg--in { background: #fff; color: var(--ink); justify-self: start; border-top-left-radius: 4px; }
  .msg--out { background: #D9FDD3; color: var(--ink); justify-self: end; border-top-right-radius: 4px; }
  .chat__alert { justify-self: center; display: flex; gap: .5rem; align-items: center; margin-top: .4rem; background: var(--lime); color: var(--deep); font-weight: 700; font-size: .85rem; padding: .55rem .9rem; border-radius: 12px; opacity: 0; animation: chat-in 12s calc(var(--s) * 1.6s) infinite; }
  .chat__alert i { font-style: normal; width: 22px; height: 22px; border-radius: 7px; background: var(--deep); color: var(--lime); display: grid; place-items: center; }
  @keyframes chat-in { 0% { opacity: 0; transform: translateY(14px) scale(.96); } 4%, 72% { opacity: 1; transform: none; } 78%, 100% { opacity: 0; transform: translateY(-6px); } }
  @media (max-width: 900px) { .wa__row { grid-template-columns: 1fr; } .chat { rotate: 0deg; } }
  @media (max-width: 640px) { .wa__split { grid-template-columns: 1fr; } .wa__ico { width: 54px; height: 54px; right: 18px; } }
  @media (prefers-reduced-motion: reduce) { .wa__ico, .wa__ico::after { animation: none; } .msg, .chat__alert { animation: none; opacity: 1; } }

  /* Bonos: la tarjeta gira en bucle, de papel a digital */
  .paper { position: relative; display: grid; place-items: center; min-height: 440px; }
  .flip { perspective: 1400px; width: min(440px, 92%); aspect-ratio: 1.8; }
  .paper__new .caption { color: var(--muted); }
  .flip__in { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; animation: bono-flip 9s cubic-bezier(.7, 0, .3, 1) infinite; }
  @keyframes bono-flip { 0%, 36% { transform: rotateY(0) rotate(-4deg); } 48%, 86% { transform: rotateY(180deg) rotate(3deg); } 98%, 100% { transform: rotateY(360deg) rotate(-4deg); } }
  .flip__face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 22px; padding: 1.6rem 1.7rem; box-shadow: 0 30px 60px -24px rgb(0 0 0 / .55); }
  .flip__back { transform: rotateY(180deg); }
  .flip__lab { position: absolute; top: -14px; left: 22px; font: 600 .72rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; padding: .6em .9em; border-radius: 99px; background: #6b5d45; color: #EFE7D6; }
