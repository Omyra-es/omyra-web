---
// Calculadora de rentabilidad y promociones. Todo se calcula en el navegador:
// sin servidor, sin registro, sin cookies ni scripts de seguimiento.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Shot from '../components/Shot.astro';
import agendaShot from '../assets/producto/agenda-dia-v2.jpg';
import Logo from '../components/Logo.astro';
import { cta } from '../content/site';
import { pricing } from '../content/pricing';
import { Image } from 'astro:assets';
import omxServicio from '../assets/producto/movil-reservas-v2.jpg';
import omxPanel from '../assets/producto/movil-informes-v2.jpg';
import omxCodigo from '../assets/producto/movil-promocion-v2.jpg';
import omxAgenda from '../assets/producto/movil-agenda-v2.jpg';

// Móvil «En Omyra»: una pantalla por paso de la calculadora (capturas reales del producto).
const omx = [
  { step: 1, img: omxServicio, t: 'Tu página de reservas, con tu marca', d: 'Tus clientas eligen servicio, profesional, fecha y hora, y reservan solas a cualquier hora.', alt: 'Página de reservas de un negocio en Omyra, en el móvil, con las categorías de servicios' },
  { step: 2, img: omxPanel, t: 'Cómo va tu negocio', d: 'Ingresos registrados, citas, valor medio por cita y clientes atendidos, en tu móvil.', alt: 'Informes de Omyra en el móvil con los ingresos, las citas, el valor medio por cita y los clientes atendidos' },
  { step: 3, img: omxCodigo, t: 'Tu promoción, en un minuto', d: 'Un código de descuento con fechas, servicios y límite de usos. Tus clientas lo escriben al reservar.', alt: 'Formulario de Omyra en el móvil para crear una promoción con código, servicios, descuento y fechas' },
  { step: 4, img: omxAgenda, t: 'Y cada cita, en tu agenda', d: 'Las reservas entran solas en la agenda de cada profesional y te avisan en el móvil.', alt: 'Agenda del día de Omyra en el móvil con las citas de cada profesional' },
];
import { BF_END, DEFAULTS } from '../scripts/calculadora/config';

const showBf = Date.now() < BF_END.getTime(); // el script lo vuelve a comprobar en el navegador
type F = { key: string; label: string; unit: string; hint?: string; mode?: 'decimal' | 'numeric'; ph?: string };
const times: F[] = [
  { key: 'prepMin', label: 'Preparación', unit: 'min', mode: 'numeric' },
  { key: 'serviceMin', label: 'Servicio', unit: 'min', mode: 'numeric' },
  { key: 'cleanMin', label: 'Limpieza', unit: 'min', mode: 'numeric' },
  { key: 'adminMin', label: 'Gestión posterior', unit: 'min', mode: 'numeric', hint: 'Mensajes, cobro, ficha' },
];
const costs: F[] = [
  { key: 'materials', label: 'Materiales y productos por servicio', unit: '€', hint: 'Esmaltes, tintes, pestañas…' },
  { key: 'consumables', label: 'Consumibles por servicio', unit: '€', hint: 'Guantes, limas, algodón…' },
  { key: 'otherVariable', label: 'Otros costes variables por servicio', unit: '€', hint: 'Comisión del datáfono, lavandería…' },
  { key: 'fixedMonthly', label: 'Gastos fijos mensuales', unit: '€', hint: 'Alquiler, luz, programas, cuota de autónomos…' },
  { key: 'servicesPerMonth', label: 'Servicios que haces al mes (aprox.)', unit: 'servicios', mode: 'numeric', hint: 'Contando todos tus servicios' },
  { key: 'hourlyTarget', label: '¿Cuánto quieres ganar por cada hora de trabajo?', unit: '€/h', hint: 'Lo que vale tu tiempo, aparte de los costes' },
];
const v = (k: string) => String((DEFAULTS as Record<string, unknown>)[k]).replace('.', ',');
---
<Base title="Calculadora de rentabilidad y promociones para salones · Omyra" description="Descubre cuánto vale tu trabajo, cuánto puedes descontar sin perder y qué promociones te convienen. Gratis y sin registrarte.">
  <PageHero eyebrow="Herramienta gratuita" title="¿Cuánto puedes descontar <span class='gold'>sin regalar tu trabajo?</span>" lead="Descubre cuánto vale realmente cada servicio. Calcula tus costes, valora tu tiempo y crea promociones que tengan sentido para tu negocio.">
    {showBf && <p slot="pre" class="bfline" data-bf>✦ Prepara tu Black Friday</p>}
    <Fragment slot="actions"><Button href="#modo" size="lg" arrow>Empezar a calcular</Button></Fragment>
    <div class="hv">
      <p class="hv__tag">Así es Omyra por dentro</p>
      <Shot src={agendaShot} alt="Agenda del día en Omyra con las citas de cada profesional y el aviso de una nueva reserva online" eager class="hv__shot" />
      <div class="teaser" aria-hidden="true">
        <p class="teaser__k">Ejemplo · Manicura semipermanente</p>
        <p class="teaser__big">Puedes descontar hasta un <b>11&nbsp;%</b></p>
        <p class="teaser__s">sin bajar de tu objetivo de 15&nbsp;€/h</p>
        <div class="teaser__bar"><i style="width:73%"></i></div>
        <p class="teaser__s">Precio mínimo: <b>35,50&nbsp;€</b> sin IVA</p>
      </div>
    </div>
  </PageHero>

  <section class="calc-sec" id="calculadora" data-mode="promocion">
    <div class="wrap">
      <form class="calc" id="calc" novalidate onsubmit="return false" autocomplete="off">
        <!-- Modo -->
        <fieldset class="modes" id="modo">
          <legend class="sr-only">¿Qué quieres hacer?</legend>
          <label class="mode">
            <input type="radio" name="mode" value="promocion" checked />
            <span class="mode__in"><span class="mode__t">Quiero preparar una promoción</span><span class="mode__d">Black Friday, Navidad, San Valentín, rebajas… Simula descuentos y descubre cuánto puedes bajar sin perder.</span></span>
          </label>
          <label class="mode">
            <input type="radio" name="mode" value="precios" />
            <span class="mode__in"><span class="mode__t">Quiero revisar mis precios</span><span class="mode__d">Conoce tus costes, valora tu tiempo y calcula tu precio mínimo.</span></span>
          </label>
        </fieldset>

        <!-- Paso 1 -->
        <section class="step" aria-labelledby="s1" data-step="1">
          <h2 class="step__h" id="s1"><span class="step__n">1</span>Tu servicio</h2>
          <div class="field">
            <label for="f-name">Nombre del servicio <span class="opt">(opcional)</span></label>
            <input id="f-name" data-key="name" type="text" maxlength="60" placeholder="Manicura semipermanente" />
          </div>
          <div class="field">
            <label for="f-price">Precio habitual</label>
            <div class="inp"><input id="f-price" data-key="price" inputmode="decimal" value={v('price')} aria-describedby="e-price" /><span class="unit">€</span></div>
            <p class="err" id="e-price" hidden></p>
          </div>
          <div class="row2">
            <div class="field">
              <span class="lbl" id="l-vat">¿El precio incluye IVA?</span>
              <button type="button" class="switch" role="switch" aria-checked="true" aria-labelledby="l-vat" id="f-incvat"><span class="switch__k"></span><span class="switch__on">Sí</span><span class="switch__off">No</span></button>
            </div>
            <div class="field">
              <label for="f-vat">Tipo de IVA</label>
              <div class="vatrow">
                <div class="chips" role="group" aria-label="Tipos de IVA habituales">
                  <button type="button" class="chip-b" data-vat="21">21 %</button><button type="button" class="chip-b" data-vat="10">10 %</button><button type="button" class="chip-b" data-vat="0">0 %</button>
                </div>
                <div class="inp inp--s"><input id="f-vat" data-key="vatPct" inputmode="decimal" value={v('vatPct')} aria-describedby="e-vatPct" /><span class="unit">%</span></div>
              </div>
              <p class="err" id="e-vatPct" hidden></p>
            </div>
          </div>
          <div class="sub">
            <p class="sub__h">¿Cuánto tiempo dedicas realmente?</p>
            <p class="hint">No solo cuenta el tiempo que estás con la clienta.</p>
            <div class="grid2 mt-s">
              {times.map((f) => (
                <div class="field">
                  <label for={`f-${f.key}`}>{f.label}</label>
                  <div class="inp"><input id={`f-${f.key}`} data-key={f.key} inputmode="numeric" value={v(f.key)} aria-describedby={`e-${f.key}`} /><span class="unit">{f.unit}</span></div>
                  {f.hint && <p class="hint">{f.hint}</p>}
                  <p class="err" id={`e-${f.key}`} hidden></p>
                </div>
              ))}
            </div>
            <p class="sum">Tiempo total de trabajo: <b data-r="totalTime">1 h 30 min</b></p>
            <p class="tip" data-r="timeTip" hidden>Muchas profesionales creen que un servicio les ocupa una hora, cuando realmente les consume una hora y media.</p>
          </div>
        </section>

        <aside class="omx-inline" data-omx-inline="1" aria-label="Así lo haces con Omyra">
          <Image src={omx[0].img} alt={omx[0].alt} widths={[240]} sizes="96px" loading="lazy" format="webp" quality={78} class="omx-inline__img" />
          <div><p class="omx__k">Con Omyra</p><p class="omx__t">{omx[0].t}</p><p class="omx__d">{omx[0].d}</p></div>
        </aside>

        <!-- Paso 2 -->
        <section class="step" aria-labelledby="s2" data-step="2">
          <h2 class="step__h" id="s2"><span class="step__n">2</span>Tus costes <span class="step__tag">sin IVA</span></h2>
          <div class="grid2">
            {costs.map((f) => (
              <div class="field">
                <label for={`f-${f.key}`}>{f.label}</label>
                <div class="inp"><input id={`f-${f.key}`} data-key={f.key} inputmode={f.mode ?? 'decimal'} value={v(f.key)} aria-describedby={`e-${f.key}`} /><span class="unit">{f.unit}</span></div>
                {f.hint && <p class="hint">{f.hint}</p>}
                <p class="err" id={`e-${f.key}`} hidden></p>
              </div>
            ))}
          </div>
          <dl class="sumlist">
            <div><dt>Coste directo por servicio</dt><dd data-r="cv">8,00 €</dd></div>
            <div><dt>Gastos fijos asignados por servicio</dt><dd data-r="gf">5,00 €</dd></div>
            <div class="sumlist__t"><dt>Coste total asignado <span>(antes de pagar tu tiempo)</span></dt><dd data-r="ca">13,00 €</dd></div>
          </dl>
        </section>

        <aside class="omx-inline" data-omx-inline="2" aria-label="Así lo haces con Omyra">
          <Image src={omx[1].img} alt={omx[1].alt} widths={[240]} sizes="96px" loading="lazy" format="webp" quality={78} class="omx-inline__img" />
          <div><p class="omx__k">Con Omyra</p><p class="omx__t">{omx[1].t}</p><p class="omx__d">{omx[1].d}</p></div>
        </aside>

        <!-- Paso 3 · promoción -->
        <section class="step" aria-labelledby="s3p" data-only="promocion" data-step="3">
          <h2 class="step__h" id="s3p"><span class="step__n">3</span>Tu promoción</h2>
          <div class="tabs" role="tablist" aria-label="Tipo de promoción">
            <button type="button" role="tab" id="t-pct" aria-selected="true" aria-controls="p-pct" data-promo="pct">Descuento en %</button>
            <button type="button" role="tab" id="t-eur" aria-selected="false" aria-controls="p-eur" data-promo="eur" tabindex="-1">Descuento en €</button>
            <button type="button" role="tab" id="t-fixed" aria-selected="false" aria-controls="p-fixed" data-promo="fixed" tabindex="-1">Precio cerrado</button>
          </div>
          <div role="tabpanel" id="p-pct" aria-labelledby="t-pct" class="panel">
            <div class="pctrow">
              <input type="range" id="f-range" min="0" max="60" step="5" value="20" aria-label="Descuento en porcentaje" />
              <div class="inp inp--s"><input id="f-pct" data-key="pct" inputmode="decimal" value="20" aria-label="Descuento en %" aria-describedby="e-pct" /><span class="unit">%</span></div>
            </div>
            <div class="chips" role="group" aria-label="Descuentos rápidos">
              {[10, 15, 20, 30].map((n) => <button type="button" class="chip-b" data-pct={n}>{n} %</button>)}
            </div>
            <p class="err" id="e-pct" hidden></p>
          </div>
          <div role="tabpanel" id="p-eur" aria-labelledby="t-eur" class="panel" hidden>
            <div class="field">
              <label for="f-eur">Descuento en euros <span class="opt" data-r="vatNote">(con IVA)</span></label>
              <div class="inp"><input id="f-eur" data-key="eur" inputmode="decimal" value="8" aria-describedby="e-eur" /><span class="unit">€</span></div>
              <p class="err" id="e-eur" hidden></p>
            </div>
          </div>
          <div role="tabpanel" id="p-fixed" aria-labelledby="t-fixed" class="panel" hidden>
            <div class="field">
              <label for="f-fixed">Precio promocional <span class="opt" data-r="vatNote">(con IVA)</span></label>
              <div class="inp"><input id="f-fixed" data-key="fixed" inputmode="decimal" value="32" aria-describedby="e-fixed" /><span class="unit">€</span></div>
              <p class="err" id="e-fixed" hidden></p>
            </div>
          </div>
        </section>

        <!-- Paso 3 · precios -->
        <section class="step" aria-labelledby="s3r" data-only="precios" hidden data-step="3">
          <h2 class="step__h" id="s3r"><span class="step__n">3</span>Tu objetivo mensual</h2>
          <div class="field">
            <label for="f-monthly">¿Cuánto quieres que te quede al mes por tu trabajo?</label>
            <div class="inp"><input id="f-monthly" data-key="monthly" inputmode="decimal" value="1.500" aria-describedby="e-monthly" /><span class="unit">€</span></div>
            <p class="err" id="e-monthly" hidden></p>
          </div>
        </section>

        <aside class="omx-inline" data-omx-inline="3" aria-label="Así lo haces con Omyra">
          <Image src={omx[2].img} alt={omx[2].alt} widths={[240]} sizes="96px" loading="lazy" format="webp" quality={78} class="omx-inline__img" />
          <div><p class="omx__k">Con Omyra</p><p class="omx__t">{omx[2].t}</p><p class="omx__d">{omx[2].d}</p></div>
        </aside>

        <!-- Móvil «En Omyra» (escritorio ancho: columna central fija) -->
        <aside class="omx-side" aria-label="Así lo haces con Omyra">
          <p class="omx__k">Así lo haces con Omyra</p>
          <div class="omx-phone">
            <div class="omx-phone__screen">
              {omx.map((o, i) => <Image src={o.img} alt={o.alt} widths={[300, 600]} sizes="240px" loading={i === 0 ? 'eager' : 'lazy'} format="webp" quality={80} data-omx={o.step} class:list={[{ on: i === 0 }]} />)}
            </div>
          </div>
          {omx.map((o, i) => <div class:list={['omx__txt', { on: i === 0 }]} data-omx-t={o.step}><p class="omx__t">{o.t}</p><p class="omx__d">{o.d}</p></div>)}
          <ol class="omx__dots" aria-hidden="true">{omx.map((o, i) => <li class:list={[{ on: i === 0 }]} data-omx-d={o.step}></li>)}</ol>
        </aside>

        <!-- Resultados (en escritorio, columna derecha fija) -->
        <aside class="res" id="resultados" aria-live="polite" aria-label="Resultados">
          <div data-only="promocion">
            <p class="res__k">Tu promoción</p>
            <div class="prices">
              <div><span class="res__l">Precio habitual</span><b data-r="priceShown">48,40 €</b><small data-r="priceNet"></small></div>
              <span class="prices__arr" aria-hidden="true">→</span>
              <div><span class="res__l">Precio promocional</span><b class="lime" data-r="promoShown">38,72 €</b><small data-r="promoNet"></small></div>
            </div>
            <div class="kpis">
              <div><span class="res__l">Disponible por servicio</span><b data-r="available">—</b><small>después de costes asignados</small></div>
              <div><span class="res__l">Disponible por hora</span><b class="lime" data-r="perHour">—</b><small data-r="targetLabel">objetivo 15 €/h</small></div>
            </div>
            <p class="status" data-r="status" data-s="below">Por debajo de tu objetivo</p>
            <p class="res__msg" data-r="diffMsg"></p>
            <div class="res__block">
              <p class="res__l">¿Cuántas citas más necesitarías?</p>
              <p data-r="extra"></p>
            </div>
            <p class="key" data-r="maxMsg"></p>
            <div class="res__block">
              <p data-r="slot"></p>
              <p class="small">No siempre se habría vendido esa cita: tómalo como una oportunidad, no como dinero perdido.</p>
            </div>
          </div>
          <div data-only="precios" hidden>
            <p class="res__k">Tu precio</p>
            <div class="kpis">
              <div><span class="res__l">Remuneración por hora</span><b class="lime" data-r="perHourP">—</b><small data-r="targetLabelP">objetivo 15 €/h</small></div>
              <div><span class="res__l">Disponible por servicio</span><b data-r="availableP">—</b><small>después de costes asignados</small></div>
            </div>
            <div class="res__block">
              <p class="res__l">Precio mínimo orientativo</p>
              <p class="big"><b class="lime" data-r="minNet">—</b> sin IVA · <b data-r="minGross">—</b> con IVA</p>
            </div>
            <div class="kpis">
              <div><span class="res__l">Citas al mes para tu objetivo</span><b data-r="goalAppts">—</b></div>
              <div><span class="res__l">Horas de trabajo</span><b data-r="goalHours">—</b></div>
            </div>
            <p class="res__msg" data-r="hoursWarn" hidden>Con este precio necesitarías trabajar más de 40 horas a la semana solo en este servicio. Puede que tu precio esté bajo.</p>
            <p class="res__msg" data-r="surplusMsg"></p>
          </div>
          <p class="legal">Simulación orientativa. No representa beneficio neto ni incluye impuestos sobre beneficios u otros costes que no se hayan introducido.</p>
        </aside>

        <!-- Paso 4 · informe -->
        <section class="step step--report" aria-labelledby="s4" id="informe" data-step="4">
          <h2 class="step__h" id="s4"><span class="step__n">4</span>Tu informe</h2>
          <article class="report" id="report">
            <div class="report__head">
              <div class="print-only report__brand"><Logo variant="verde" width={120} /><span data-r="date"></span></div>
              <p class="report__t">Tu análisis de rentabilidad</p>
              <p class="report__s" data-r="reportSub">TU SERVICIO · PROMOCIÓN DEL 20 %</p>
            </div>
            <dl class="report__rows">
              <div><dt>Tiempo invertido</dt><dd data-r="rTime">—</dd></div>
              <div><dt>Precio habitual</dt><dd data-r="rPrice">—</dd></div>
              <div data-only="promocion"><dt>Precio promocional</dt><dd data-r="rPromo">—</dd></div>
              <div><dt>Objetivo de remuneración</dt><dd data-r="rTarget">—</dd></div>
              <div><dt>Remuneración efectiva estimada</dt><dd data-r="rEffective">—</dd></div>
              <div data-only="promocion"><dt>Descuento máximo orientativo</dt><dd data-r="rMax">—</dd></div>
            </dl>
            <div class="report__hl">
              <p>Tu precio mínimo orientativo: <b data-r="rMinNet">—</b> sin IVA (<b data-r="rMinGross">—</b> con IVA)</p>
              <p class="small">Antes de IVA y sin incluir un beneficio adicional para el negocio, según los costes y objetivos que has introducido.</p>
            </div>
            <div class="report__mean">
              <p class="report__l">¿Qué significa para ti?</p>
              <p data-r="meaning"></p>
            </div>
            <div class="report__mean" data-only="promocion">
              <p class="report__l">Antes de lanzar tu promoción, piensa en esto</p>
              <ul class="checks">
                <li>¿Tienes huecos libres suficientes?</li>
                <li>¿La promoción atraerá clientas nuevas?</li>
                <li>¿Es probable que vuelvan después a tu precio habitual?</li>
              </ul>
            </div>
            <p class="legal legal--light">Simulación orientativa. No representa beneficio neto ni incluye impuestos sobre beneficios u otros costes que no se hayan introducido.</p>
            <p class="print-only report__src">Calculado con la herramienta gratuita de Omyra · <b>omyra.es/calculadora</b></p>
            <section class="print-only omy" aria-hidden="true">
              <p class="omy__k">Cómo te ayuda Omyra</p>
              <h3 class="omy__h">Lleva tu promoción a tu agenda, <span>sin perseguir mensajes.</span></h3>
              <ol class="omy__steps">
                <li><b>Crea tu promoción.</b> Un código de descuento con fechas, servicios y límite de usos: plazas contadas, como en el cálculo que acabas de hacer.</li>
                <li><b>Compártela con tu enlace de reservas.</b> Tus clientas reservan solas desde Instagram, WhatsApp o Google, en tu página con tu marca. Solo ven los huecos que tú habilitas y escriben el código al reservar.</li>
                <li><b>Omyra hace el resto.</b> Tu clienta recibe la confirmación y el recordatorio por correo, tú el aviso en el móvil, y la cita entra directa en tu agenda.</li>
                <li><b>Y después, vuelve a tu precio.</b> El código deja de aplicarse en la fecha de fin que pongas, y la ficha de cada clienta guarda su historial y tus notas.</li>
              </ol>
              <figure class="omy__shot"><Image src={agendaShot} alt="" widths={[1200]} sizes="700px" loading="eager" format="webp" quality={82} /><figcaption>La agenda de Omyra: cada reserva entra sola, con su profesional y su servicio.</figcaption></figure>
              <div class="omy__cta">
                <p><b>Pruébalo en omyra.es/empieza</b></p>
                <p>{pricing.full} · todas las funcionalidades · profesionales ilimitados · sin permanencia</p>
              </div>
            </section>
          </article>
          <div class="report__btns">
            <button type="button" class="btn-x btn-x--green" id="copyReport">Copiar informe</button>
            <button type="button" class="btn-x" id="printReport">Descargar en PDF</button>
          </div>
          <textarea class="sr-only" id="copyFallback" aria-hidden="true" tabindex="-1" readonly></textarea>
          <p class="reset"><button type="button" id="resetData">Borrar mis datos</button></p>
        </section>
      </form>
    </div>
  </section>

  {showBf && (
    <section class="sec bg-cream is-light bf" data-bf data-only="promocion">
      <div class="wrap">
        <p class="eyebrow">Black Friday sin miedo</p>
        <h2 class="h2 balance mt-2 bf__h">Black Friday, sí. <span class="gold-ink">Regalar tu trabajo, no.</span></h2>
        <div class="bf__cards mt-4">
          <article class="bf__card"><span class="bf__n">01</span><h3>Solo en tus horas flojas.</h3><p>Martes por la mañana, primera hora… Llenas huecos que hoy no aprovechas, sin tocar tus horas llenas.</p></article>
