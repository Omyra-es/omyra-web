---
// Alta online. Contrato con la app: docs/alta-autonoma/ALTA-ONLINE.md (la web no cobra ni crea cuentas).
import Base from '../layouts/Base.astro';
import { site, cta, signup, hubspot, hubspotSignup } from '../content/site';
import { pricing } from '../content/pricing';

const eur = (n: number) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: pricing.currencyCode }).format(n);
const base = pricing.amountNumber;
const vat = Math.round(base * pricing.taxRate * 100) / 100;
const total = Math.round((base + vat) * 100) / 100;
const price = { base: eur(base), vat: eur(vat), total: eur(total) };

const sectors = ['Estética', 'Peluquería', 'Uñas', 'Pestañas y cejas', 'Barbería', 'Fisioterapia y bienestar', 'Otro'];
const teams = ['Solo yo', '2 a 5 personas', '6 a 10 personas', 'Más de 10'];
const provinces = ['A Coruña', 'Álava', 'Albacete', 'Alicante', 'Almería', 'Asturias', 'Ávila', 'Badajoz', 'Barcelona', 'Burgos', 'Cáceres', 'Cádiz', 'Cantabria', 'Castellón', 'Ceuta', 'Ciudad Real', 'Córdoba', 'Cuenca', 'Girona', 'Granada', 'Guadalajara', 'Gipuzkoa', 'Huelva', 'Huesca', 'Illes Balears', 'Jaén', 'La Rioja', 'Las Palmas', 'León', 'Lleida', 'Lugo', 'Madrid', 'Málaga', 'Melilla', 'Murcia', 'Navarra', 'Ourense', 'Palencia', 'Pontevedra', 'Salamanca', 'Santa Cruz de Tenerife', 'Segovia', 'Sevilla', 'Soria', 'Tarragona', 'Teruel', 'Toledo', 'Valencia', 'Valladolid', 'Bizkaia', 'Zamora', 'Zaragoza'];

const cfg = {
  endpoint: signup.endpoint,
  termsVersion: signup.termsVersion,
  plan: signup.plan,
  loginUrl: signup.loginUrl,
  payLink: signup.paymentLink && /^https:\/\/buy\.stripe\.com\//.test(signup.paymentLink) ? signup.paymentLink : null,
  hs: hubspot.portalId && hubspotSignup.formId ? `https://api-eu1.hsforms.com/submissions/v3/integration/submit/${hubspot.portalId}/${hubspotSignup.formId}` : null,
  total: price.total,
  email: site.contact.email,
  wa: site.contact.whatsappHref,
  phone: site.contact.phone,
  phoneHref: site.contact.phoneHref,
};
---
<Base title="Empieza con Omyra · Alta online" description={`Date de alta en Omyra: ${pricing.full}, sin permanencia.`} noindex>


  <div class="shell bg-green is-dark">
  <div class="mini">
    <span>Omyra · <strong>{price.base}</strong> {pricing.tax} {pricing.period}</span>
    <button type="button" id="miniBtn" aria-expanded="false" aria-controls="sum">Ver detalle</button>
  </div>
  <div class="wrap main">
    <section class="flow">
      <div class="intro">
        <p class="eyebrow">Alta online · Sin permanencia</p>
        <h1 class="intro__h">Empieza con Omyra <span class="firma">hoy</span></h1>
        <p class="intro__lead">Tú trabajas, tus clientes reservan. Deja tu Omyra listo hoy y empieza a recibir reservas con tu marca, sin permanencia y sin comisiones por reserva.</p>
        <p class="intro__demo">¿Prefieres verlo antes? <a href={cta.demo.href}>Te lo enseñamos en una demo →</a><br />¿Dudas? Escríbenos por <a href={site.contact.whatsappHref}>WhatsApp</a> o llámanos al <a href={site.contact.phoneHref}>{site.contact.phone}</a>.</p>
      </div>

      <ol class="steps" aria-label="Pasos del alta">
        {['Tu cuenta', 'Tu negocio', 'Facturación', 'Revisa y paga'].map((s, i) => (
          <li data-dot={i + 1}><span class="steps__n">Paso {i + 1}</span><span class="steps__l">{s}</span></li>
        ))}
      </ol>

      <div id="note" class="note-slot" role="status" aria-live="polite"></div>

      <form id="alta" novalidate>
        <div class="hp" aria-hidden="true"><label for="f-website">No rellenes este campo</label><input id="f-website" name="website" tabindex="-1" autocomplete="off" /></div>

        <fieldset class="card" data-step="1">
          <legend class="card__h">Tu cuenta</legend>
          <p class="card__sub">Con estos datos creamos tu acceso a Omyra. Al pagar entras directamente y lo primero que harás será elegir tu contraseña.</p>
          <div class="f2">
            <div class="field"><label for="f-firstName">Nombre</label><input id="f-firstName" name="firstName" autocomplete="given-name" required /><p class="err" id="e-firstName"></p></div>
            <div class="field"><label for="f-lastName">Apellidos</label><input id="f-lastName" name="lastName" autocomplete="family-name" required /><p class="err" id="e-lastName"></p></div>
          </div>
          <div class="f2">
            <div class="field"><label for="f-email">Correo electrónico</label><input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required /><p class="err" id="e-email"></p></div>
            <div class="field"><label for="f-phone">Móvil</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="600 123 456" required /><p class="err" id="e-phone"></p></div>
          </div>
          <div class="actions"><button type="button" class="next" data-next>Continuar <span aria-hidden="true">→</span></button></div>
          <p class="small">Al continuar guardamos estos datos para poder ayudarte si no terminas el alta. Solo te escribiremos sobre tu alta en Omyra. <a href="/privacidad">Privacidad</a>.</p>
        </fieldset>

        <fieldset class="card" data-step="2" hidden>
          <legend class="card__h">Tu negocio</legend>
          <div class="field"><label for="f-businessName">Nombre del negocio</label><input id="f-businessName" name="businessName" autocomplete="organization" required aria-describedby="h-businessName" /><span class="hint" id="h-businessName">Es el nombre que verán tus clientes al reservar.</span><p class="err" id="e-businessName"></p></div>
          <div class="field" role="radiogroup" aria-labelledby="l-sector"><span class="lbl" id="l-sector">Sector</span>
            <div class="chips">{sectors.map((s) => <label><input type="radio" name="sector" value={s} required />{s}</label>)}</div>
            <p class="err" id="e-sector"></p></div>
          <div class="field" role="radiogroup" aria-labelledby="l-team"><span class="lbl" id="l-team">¿Cuántas personas atienden?</span>
            <div class="chips">{teams.map((s) => <label><input type="radio" name="teamSize" value={s} required />{s}</label>)}</div>
            <p class="err" id="e-teamSize"></p></div>
          <div class="field field--half"><label for="f-city">Ciudad</label><input id="f-city" name="city" autocomplete="address-level2" required /><p class="err" id="e-city"></p></div>
          <div class="actions"><button type="button" class="back" data-back>← Atrás</button><button type="button" class="next" data-next>Continuar <span aria-hidden="true">→</span></button></div>
        </fieldset>

        <fieldset class="card" data-step="3" hidden>
          <legend class="card__h">Facturación</legend>
          <p class="card__sub">Para emitir tu factura de Omyra cada mes.</p>
          <div class="f2">
            <div class="field"><label for="f-taxId">NIF / CIF</label><input id="f-taxId" name="taxId" autocomplete="off" autocapitalize="characters" required /><p class="err" id="e-taxId"></p><p class="ok" id="ok-taxId" hidden>✓ NIF correcto</p></div>
            <div class="field"><label for="f-legalName">Nombre fiscal o razón social</label><input id="f-legalName" name="legalName" required /><p class="err" id="e-legalName"></p></div>
          </div>
          <div class="field"><label for="f-address">Dirección</label><input id="f-address" name="address" autocomplete="street-address" required /><p class="err" id="e-address"></p></div>
          <div class="f3">
            <div class="field"><label for="f-postalCode">Código postal</label><input id="f-postalCode" name="postalCode" autocomplete="postal-code" inputmode="numeric" maxlength="5" required /><p class="err" id="e-postalCode"></p></div>
            <div class="field"><label for="f-billCity">Población</label><input id="f-billCity" name="billCity" autocomplete="address-level2" required /><p class="err" id="e-billCity"></p></div>
            <div class="field"><label for="f-province">Provincia</label><select id="f-province" name="province" required><option value="">Elige</option>{provinces.sort((a, b) => a.localeCompare(b, 'es')).map((p) => <option>{p}</option>)}</select><p class="err" id="e-province"></p></div>
          </div>
          <div class="actions"><button type="button" class="back" data-back>← Atrás</button><button type="button" class="next" data-next>Continuar <span aria-hidden="true">→</span></button></div>
        </fieldset>

        <fieldset class="card" data-step="4" hidden>
          <legend class="card__h">Revisa y paga</legend>
          <div class="review">
            <div class="rv"><h3>Tu cuenta</h3><p id="rv-1"></p><button type="button" data-goto="1">Cambiar</button></div>
            <div class="rv"><h3>Tu negocio</h3><p id="rv-2"></p><button type="button" data-goto="2">Cambiar</button></div>
            <div class="rv"><h3>Facturación</h3><p id="rv-3"></p><button type="button" data-goto="3">Cambiar</button></div>
          </div>
          <div class="guide"><span class="guide__star" aria-hidden="true">✦</span><p><b>Lo dejas listo tú, paso a paso.</b> Al entrar, Omyra te guía para configurar tu página de reservas, tu horario, tus servicios y tu equipo. Es muy sencillo.<br /><span class="guide__help">¿Te surge alguna duda? Estamos contigo por <a href={site.contact.whatsappHref}>WhatsApp</a> o en el <a href={site.contact.phoneHref}>{site.contact.phone}</a>.</span></p></div>
          <div class="field field--check"><input id="f-terms" name="terms" type="checkbox" required /><label for="f-terms">He leído y acepto las <a href="/condiciones-de-contratacion" target="_blank">condiciones de contratación</a> y el <a href="/encargo-del-tratamiento" target="_blank">encargo del tratamiento</a>, y la <a href="/privacidad" target="_blank">política de privacidad</a>.</label><p class="err" id="e-terms"></p></div>
          <div class="stripe"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span>El pago se hace en la página segura de <b>Stripe</b>. Omyra no ve ni guarda los datos de tu tarjeta.</span></div>
          <div class="actions"><button type="button" class="back" data-back>← Atrás</button><button type="submit" class="next pay" id="pay">Ir al pago · {price.total} <span aria-hidden="true">→</span></button></div>
          <p class="small"><b>Protección de datos.</b> Responsable: Omyra. Finalidad: crear tu cuenta, cobrar la suscripción y emitir tus facturas. Destinatario: Stripe, que procesa el pago. Puedes ejercer tus derechos de acceso, rectificación, supresión y demás escribiendo a <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>. Más información en la <a href="/privacidad">política de privacidad</a>.</p>
        </fieldset>
      </form>
    </section>

    <aside class="sum" id="sum" aria-label="Resumen del plan">
      <p class="eyebrow">Tu plan Omyra</p>
      <p class="sum__price"><span class="sum__num">{price.base}</span><span class="sum__per">{pricing.tax}<br />{pricing.period}</span></p>
      <div class="sum__today">
        <div class="date" aria-hidden="true"><span class="date__m" id="dM"></span><span class="date__d" id="dD"></span></div>
        <div class="sum__rows">
          <div><span>Plan mensual</span><span>{price.base}</span></div>
          <div><span>{pricing.taxLabel}</span><span>{price.vat}</span></div>
          <div class="sum__tot"><span>Hoy, IVA incluido</span><span>{price.total}</span></div>
        </div>
      </div>
      <ul class="sum__list" role="list">
        <li id="dNext">Se renueva cada mes, el mismo día</li>
        <li>Sin permanencia: cancelas cuando quieras</li>
        <li>Todas las funcionalidades, profesionales ilimitados y sin comisiones de Omyra</li>
      </ul>
    </aside>
  </div>
  </div>


  <script is:inline type="application/json" id="alta-cfg" set:html={JSON.stringify(cfg)} />
</Base>

<script>
  import { validators, normalize } from '../scripts/alta-validate';

  type Cfg = { endpoint: string | null; termsVersion: string; plan: string; loginUrl: string | null; payLink: string | null; hs: string | null; total: string; email: string; wa: string; phone: string; phoneHref: string };
  const cfg: Cfg = JSON.parse(document.getElementById('alta-cfg')!.textContent || '{}');
  const form = document.getElementById('alta') as HTMLFormElement;
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
  const dots = [...document.querySelectorAll<HTMLLIElement>('[data-dot]')];
  const note = document.getElementById('note')!;
  const pay = document.getElementById('pay') as HTMLButtonElement;
  const KEY = 'omyra-alta';
  let step = 1;

  // ---------- Fecha del cobro ----------
  const now = new Date();
  document.getElementById('dM')!.textContent = now.toLocaleDateString('es-ES', { month: 'short' }).replace('.', '').toUpperCase();
  document.getElementById('dD')!.textContent = String(now.getDate());
  if (now.getDate() <= 28) document.getElementById('dNext')!.textContent = `Se renueva el día ${now.getDate()} de cada mes`;

  // ---------- Resumen en móvil ----------
  const miniBtn = document.getElementById('miniBtn')!;
  miniBtn.addEventListener('click', () => {
    const open = document.body.classList.toggle('sum-open');
    miniBtn.textContent = open ? 'Ocultar' : 'Ver detalle';
    miniBtn.setAttribute('aria-expanded', String(open));
  });

  // ---------- Campos ----------
  const fieldsOf = (n: number) => [...steps[n - 1].querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name]:not([name=website]), select[name]')];
  const byName = (name: string) => form.elements.namedItem(name) as HTMLInputElement | RadioNodeList | null;
  const valueOf = (name: string) => {
    const el = byName(name);
    if (!el) return '';
    if (el instanceof RadioNodeList) return el.value;
    return el.type === 'checkbox' ? (el.checked ? 'on' : '') : el.value.trim();
  };
  const stepOf = (name: string) => steps.findIndex((s) => s.querySelector(`[name="${name}"]`)) + 1;

  function setError(name: string, msg: string) {
    const err = document.getElementById(`e-${name}`);
    if (err) err.textContent = msg;
    form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((el) => {
      if (el.type === 'radio') el.closest('.chips')?.toggleAttribute('data-invalid', Boolean(msg));
      else el.setAttribute('aria-invalid', String(Boolean(msg)));
      if (el.type !== 'radio') el.setAttribute('aria-describedby', [msg ? `e-${name}` : '', el.id === 'f-businessName' ? 'h-businessName' : ''].filter(Boolean).join(' '));
    });
    if (name === 'taxId') document.getElementById('ok-taxId')!.hidden = Boolean(msg) || !valueOf('taxId');
  }
  function check(name: string) {
    const msg = validators[name]?.(valueOf(name)) ?? '';
    setError(name, msg);
    return !msg;
  }
  const names = (n: number) => [...new Set(fieldsOf(n).map((f) => f.name))];
  function checkStep(n: number) {
    const bad = names(n).filter((nm) => !check(nm));
    if (bad.length) focusField(bad[0]);
    return !bad.length;
  }
  function focusField(name: string) {
    const el = form.querySelector<HTMLElement>(`[name="${name}"]`);
    el?.focus({ preventScroll: true });
    el?.closest('.field')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  form.addEventListener('focusout', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name && t.name !== 'website' && t.type !== 'radio' && (t.value || t.getAttribute('aria-invalid') === 'true')) check(t.name);
  });
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type === 'radio' || t.type === 'checkbox' || t.tagName === 'SELECT') check(t.name);
    save();
  });
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.getAttribute('aria-invalid') === 'true') check(t.name);
    save();
  });

  // ---------- Guardado en el navegador (solo durante la visita) ----------
  function save() {
    const data: Record<string, string> = {};
    for (let n = 1; n <= 4; n++) names(n).forEach((nm) => { if (nm !== 'terms') data[nm] = valueOf(nm); });
    try { sessionStorage.setItem(KEY, JSON.stringify({ data, step })); } catch { /* sin almacenamiento */ }
  }
  function restore() {
    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      if (!saved) return 1;
      for (const [nm, v] of Object.entries(saved.data as Record<string, string>)) {
        const el = byName(nm);
        if (!el || !v) continue;
        if (el instanceof RadioNodeList) el.value = v; else el.value = v;
      }
      return Math.min(4, Math.max(1, Number(saved.step) || 1));
    } catch { return 1; }
  }

  // ---------- Pasos ----------
  function go(n: number, focus = true) {
    step = n;
    steps.forEach((s, i) => (s.hidden = i + 1 !== n));
    dots.forEach((d, i) => {
      d.dataset.s = i + 1 < n ? 'done' : i + 1 === n ? 'now' : '';
      if (i + 1 === n) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current');
    });
    if (n === 4) fillReview();
    save();
    if (focus) {
      steps[n - 1].querySelector<HTMLElement>('legend')?.focus?.();
      document.querySelector('.steps')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  form.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => {
    if (!checkStep(step)) return;
    clearNote();
    track(step + 1);
    go(step + 1);
  }));
  form.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', () => go(step - 1)));
  form.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.goto))));

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  function fillReview() {
    const v = valueOf;
    document.getElementById('rv-1')!.innerHTML = esc(`${v('firstName')} ${v('lastName')} · ${normalize.email(v('email'))} · ${normalize.phone(v('phone'))}`);
    document.getElementById('rv-2')!.innerHTML = esc(`${v('businessName')} · ${v('sector')} · ${v('teamSize')} · ${v('city')}`);
    document.getElementById('rv-3')!.innerHTML = `${esc(`${v('legalName')} · ${normalize.taxId(v('taxId'))}`)}<br>${esc(`${v('address')}, ${v('postalCode')} ${v('billCity')} (${v('province')})`)}`;
  }

  // ---------- Avisos ----------
  const contact = `escríbenos por <a href="${cfg.wa}">WhatsApp</a>, llámanos al <a href="${cfg.phoneHref}">${cfg.phone}</a> o escribe a <a href="mailto:${cfg.email}">${cfg.email}</a>`;
  const notes: Record<string, [string, string, string]> = {
    cancelado: ['warn', 'No se te ha cobrado nada.', 'Has vuelto sin terminar el pago. Tus datos siguen aquí: revísalos y vuelve a intentarlo cuando quieras.'],
    pronto: ['warn', 'El alta online se abre muy pronto.', `Mientras tanto, ${contact} y te damos de alta nosotros.`],
    existe: ['info', 'Ya existe una cuenta con este correo.', ''],
    campos: ['err', 'Revisa los campos marcados.', 'Te hemos llevado al primero que hay que corregir.'],
    fallo: ['err', 'No hemos podido preparar el pago. No se te ha cobrado nada.', `Vuelve a intentarlo en unos minutos o ${contact}.`],
  };
  function showNote(kind: string, extra = '') {
    const [tone, title, body] = notes[kind];
    note.innerHTML = `<div class="note note--${tone}"><b>${title}</b><span>${body}${extra}</span></div>`;
    note.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function clearNote() { note.innerHTML = ''; }

  // ---------- Origen de la visita ----------
  function source() {
    // page: página del alta (como en el contrato); landingPage: primera página que vio en la visita.
    try {
      const s = JSON.parse(sessionStorage.getItem('omyra-origen') || '{}');
      return { ...s, landingPage: s.page || location.pathname, page: location.pathname };
    } catch { return { page: location.pathname }; }
  }

  // ---------- Altas a medias (HubSpot) ----------
  const STEP_NAMES = ['', 'Tu cuenta', 'Tu negocio', 'Facturación', 'Revisa y paga', 'Ir al pago'];
  function track(reached: number) {
    if (!cfg.hs || valueOf('website')) return;
    const src = source();
    const origin = [src.utm_source, src.utm_medium, src.utm_campaign, src.utm_content, src.ref && `ref:${src.ref}`, src.referrer].filter(Boolean).join(' · ') || 'directo';
    const fields = [
      ['firstname', valueOf('firstName')], ['lastname', valueOf('lastName')], ['email', normalize.email(valueOf('email'))],
      ['phone', normalize.phone(valueOf('phone'))], ['company', valueOf('businessName')],
      ['paso_del_alta', `${reached} · ${STEP_NAMES[reached]}`], ['origen_del_alta', origin],
    ].filter(([, v]) => v).map(([name, value]) => ({ name, value }));
    fetch(cfg.hs, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true,
      body: JSON.stringify({ fields, context: { pageUri: location.href.split('?')[0], pageName: 'Alta online' } }),
    }).catch(() => { /* no bloquea el alta */ });
  }

  // ---------- Envío a la app ----------
  const FIELD_MAP: Record<string, string> = { email: 'email', phone: 'phone', taxId: 'taxId', postalCode: 'postalCode', businessName: 'businessName', firstName: 'firstName', lastName: 'lastName', city: 'city', legalName: 'legalName', address: 'address', province: 'province', sector: 'sector', teamSize: 'teamSize' };
  function payload() {
    const v = valueOf;
    return {
      version: 1,
      account: { firstName: v('firstName'), lastName: v('lastName'), email: normalize.email(v('email')), phone: normalize.phone(v('phone')) },
      business: { name: v('businessName'), sector: v('sector'), teamSize: v('teamSize'), city: v('city') },
      billing: { taxId: normalize.taxId(v('taxId')), legalName: v('legalName'), address: v('address'), postalCode: v('postalCode'), city: v('billCity'), province: v('province'), country: 'ES' },
      plan: cfg.plan,
      wantsHelp: false,
      consent: { terms: true, termsVersion: cfg.termsVersion, privacy: true, acceptedAt: new Date().toISOString() },
      source: source(),
    };
  }
  const payLabel = pay.innerHTML;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (pay.disabled) return;
    for (let n = 1; n <= 3; n++) if (!names(n).every((nm) => !validators[nm]?.(valueOf(nm)))) { go(n); checkStep(n); showNote('campos'); return; }
    if (!check('terms')) { focusField('terms'); return; }
    if (valueOf('website')) return; // robot
    track(5);
    if (!cfg.endpoint) {
      if (!cfg.payLink) { showNote('pronto'); return; }
      // Enlace de pago de Stripe: se abre con el correo ya puesto y en español.
      pay.disabled = true;
      pay.textContent = 'Abriendo el pago…';
      const url = new URL(cfg.payLink);
      url.searchParams.set('prefilled_email', normalize.email(valueOf('email')));
      url.searchParams.set('locale', 'es');
      location.href = url.href;
      return;
    }
    pay.disabled = true;
    pay.textContent = 'Preparando el pago…';
    try {
      const res = await fetch(cfg.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload()) });
      const body = await res.json().catch(() => ({}));
      if (res.ok && typeof body.checkoutUrl === 'string' && body.checkoutUrl.startsWith('https://')) {
        location.href = body.checkoutUrl;
        return;
      }
      if (res.status === 409) {
        const login = [body.loginUrl, cfg.loginUrl].find((u) => typeof u === 'string' && u.startsWith('https://'));
        showNote('existe', login ? `Si es tuya, <a href="${esc(login)}">entra en Omyra</a>. Si no, cambia el correo en el paso 1.` : `Si es tuya, entra en Omyra con ese correo. Si no, cambia el correo en el paso 1.`);
      } else if (res.status === 422 && body.errors && typeof body.errors === 'object') {
        const keys = Object.keys(body.errors).filter((k) => FIELD_MAP[k]);
        keys.forEach((k) => setError(FIELD_MAP[k], String(body.errors[k])));
        if (keys.length) {
          const first = keys.map((k) => FIELD_MAP[k]).sort((a, b) => stepOf(a) - stepOf(b))[0];
          go(stepOf(first), false);
          showNote('campos');
          focusField(first);
        } else showNote('fallo');
      } else showNote('fallo');
    } catch {
      showNote('fallo');
    }
    pay.disabled = false;
    pay.innerHTML = payLabel;
  });

  window.addEventListener('pageshow', (e) => { if (e.persisted) { pay.disabled = false; pay.innerHTML = payLabel; } });

  // ---------- Inicio ----------
  const start = restore();
  const params = new URLSearchParams(location.search);
  if (params.get('pago') === 'cancelado') {
    go(4, false);
    showNote('cancelado');
  } else go(start, false);
  // Si vuelve con datos guardados, marca de nuevo lo que ya estaba mal.
  for (let n = 1; n < step; n++) names(n).forEach((nm) => { if (valueOf(nm)) check(nm); });
</script>

