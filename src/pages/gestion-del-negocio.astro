---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import FinalCta from '../components/FinalCta.astro';
import ClientCard from '../components/ClientCard.astro';
import AgendaCard from '../components/AgendaCard.astro';
import TeamCard from '../components/TeamCard.astro';
import { cta } from '../content/site';

const day = [
  { h: '09:00', t: 'Abres la agenda del día', d: 'Ves las citas de todo el equipo, cuántas están confirmadas y cuál es el último hueco libre.', tag: 'Agenda' },
  { h: '10:30', t: 'Una profesional no puede venir', d: 'Registras su ausencia, ves qué citas tenía y las reprogramas con otra profesional u otro horario.', tag: 'Equipo' },
  { h: '12:00', t: 'Llega un cliente', d: 'Abres su ficha: historial, notas y el consentimiento del servicio pendiente de firma, que resuelves desde la cita.', tag: 'Clientes y documentos' },
  { h: '17:00', t: 'Cobras y vendes un bono', d: 'Completas la cita registrando cómo ha pagado y asignas un bono de sesiones desde su ficha.', tag: 'Pagos y bonos' },
  { h: '20:00', t: 'Cierras el día', d: 'Revisas el informe con las citas y los cobros por método, y emites las facturas que necesitas.', tag: 'Informe y facturas' },
];
const examples = [
  { s: 'Centro de fisioterapia', d: 'Bonos de 5 sesiones, documentos de consentimiento y agenda por fisioterapeuta.' },
  { s: 'Spa y peluquería canina', d: 'Servicios por tamaño y duración, indicaciones antes de la cita y avisos de nuevas reservas.' },
  { s: 'Centro de estética', d: 'Valoraciones previas, señales para los servicios largos y códigos promocionales.' },
];
---
<Base title="Gestión del negocio · Agenda, equipo, clientes, cobros y facturas | Omyra" description="El día a día de un negocio con citas, en orden: agenda del equipo, ausencias, fichas de clientes, documentos, cobros, bonos, promociones e informe del día.">
  <PageHero eyebrow="Gestión del negocio" title="El día a día, <span class='gold'>en orden.</span>" lead="Agenda, equipo, clientes, cobros y facturas en un mismo panel. Así es un día cualquiera con Omyra.">
    <Fragment slot="actions"><Button href={cta.start.href} size="lg" arrow>{cta.start.label}</Button><Button href={cta.demo.href} variant="ghost" size="lg">{cta.demo.label}</Button></Fragment>
  </PageHero>

  <section class="sec bg-light is-light">
    <div class="wrap day">
      <div class="day__sticky">
        <p class="eyebrow">Un día con Omyra</p>
        <h2 class="h2 balance mt-2">De la primera cita <span class="gold-ink">al cierre.</span></h2>
        <div class="mt-3"><AgendaCard /></div>
      </div>
      <ol class="day__list" role="list">
        {day.map((d, i) => (
          <li class="reveal" style={`--d:${i * 0.05}s`}>
            <span class="day__h">{d.h}</span>
            <div><span class="chip">{d.tag}</span><h3 class="h3 mt-1">{d.t}</h3><p class="mt-1 text-2">{d.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec bg-green is-dark">
    <div class="wrap split split--wide-r">
      <div>
        <p class="eyebrow reveal">Equipo y horarios</p>
        <h2 class="h2 balance mt-2 reveal">Cada profesional, <span class="gold">con su horario.</span></h2>
        <p class="lead mt-2 reveal">Asigna a cada profesional sus servicios y su horario, con hasta dos turnos al día. Marca ausencias y vacaciones sin cancelar las citas ya registradas, elige los festivos de tu localidad y limita su disponibilidad a fechas concretas.</p>
      </div>
      <TeamCard />
    </div>
  </section>

  <section class="sec bg-cream is-light">
    <div class="wrap split split--wide-l">
      <ClientCard />
      <div>
        <p class="eyebrow reveal">Clientes y documentos</p>
        <h2 class="h2 balance mt-2 reveal">Todo lo de cada cliente, <span class="gold-ink">en su ficha.</span></h2>
        <ul class="ring-list mt-3">
          <li class="reveal">Historial de citas, hábitos y notas internas</li>
          <li class="reveal">Fotos y archivos en la cita o en la ficha</li>
          <li class="reveal">Consentimientos por cita o por cliente, con firma por enlace</li>
          <li class="reveal">Caducidad de cada documento e histórico de versiones</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sec bg-deep is-dark">
    <div class="wrap">
      <p class="eyebrow reveal">Cobros, bonos y facturas</p>
      <h2 class="h2 balance mt-2 reveal">Las cuentas, <span class="gold">claras al final del día.</span></h2>
      <div class="money mt-4">
        <article class="reveal"><b>Cobros</b><p>Efectivo, tarjeta, Bizum o transferencia, registrados al completar la cita y reflejados en el informe del día.</p></article>
        <article class="reveal" style="--d:.08s"><b>Bonos</b><p>Paquetes de sesiones de un servicio, con precio de venta y caducidad, asignados desde la ficha del cliente.</p></article>
        <article class="reveal" style="--d:.16s"><b>Promociones</b><p>Códigos con descuento porcentual o fijo, fechas, servicios y límites de uso por cliente.</p></article>
        <article class="reveal" style="--d:.24s"><b>Facturación</b><p>Facturas completas y simplificadas con VERI*FACTU, en PDF y listas para exportar a tu gestoría.</p></article>
      </div>
    </div>
  </section>

  <section class="sec bg-light is-light">
    <div class="wrap">
      <p class="eyebrow reveal">Para distintos negocios</p>
      <h2 class="h2 balance mt-2 reveal">Tu forma de trabajar, <span class="gold-ink">tu configuración.</span></h2>
      <div class="ex mt-4">{examples.map((e, i) => <article class="reveal" style={`--d:${i * 0.08}s`}><h3 class="h3 mt-1">{e.s}</h3><p class="mt-1 text-2">{e.d}</p></article>)}</div>
    </div>
  </section>

  <FinalCta />
</Base>

<style>
  .day { display: grid; grid-template-columns: .95fr 1.05fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .day__sticky { position: sticky; top: 110px; }
  .day__list { list-style: none; display: grid; gap: 1rem; position: relative; }
  .day__list::before { content: ''; position: absolute; left: 2.6rem; top: 1rem; bottom: 1rem; width: 2px; background: linear-gradient(var(--gold), rgb(215 243 107 / .15)); }
  .day__list li { position: relative; display: grid; grid-template-columns: 5.2rem 1fr; gap: 1rem; padding: 1.4rem; border-radius: var(--r-lg); background: var(--white); box-shadow: 0 16px 40px -30px rgb(10 43 32 / .4); }
  .day__h { width: 5.2rem; height: 2.4rem; display: grid; place-items: center; border-radius: 99px; background: var(--green); color: var(--gold); font: 600 .9rem/1 var(--mono); position: relative; }
  .money { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .money article { padding: 1.8rem; border-radius: var(--r-lg); background: rgb(247 245 241 / .05); box-shadow: inset 0 0 0 1px var(--line-dark); display: grid; gap: .7rem; align-content: start; }
  .money b { font-size: 1.5rem; letter-spacing: -.03em; color: var(--gold); }
  .money p { color: var(--on-dark); }
  .ex { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .ex article { padding: 2rem; border-radius: var(--r-lg); background: var(--cream); }
  .ex article:nth-child(2) { background: var(--green); color: var(--cream-l); --text-2: var(--on-dark); }
  .ex article:nth-child(2) .caption { color: var(--gold); }
  @media (max-width: 1000px) { .money { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) { .day { grid-template-columns: 1fr; } .day__sticky { position: static; } .ex { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .money { grid-template-columns: 1fr; } .day__list li { grid-template-columns: 1fr; } .day__list::before { display: none; } }
</style>
