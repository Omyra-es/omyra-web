---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../content/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
  headerTone?: 'dark' | 'light';
  bare?: boolean; // sin cabecera ni pie (páginas enfocadas como el alta)
}
const { title, description, noindex = false, jsonld = [], headerTone = 'dark', bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1') || '/', site.url).href;
// Píxeles publicitarios: los ID llegan por variables de entorno públicas al construir la web (no van en el código).
// Si una variable está vacía, ese píxel no se carga; si las dos lo están, no hay aviso de cookies.
const clean = (v: unknown, re: RegExp) => (typeof v === 'string' && re.test(v.trim()) ? v.trim() : null);
const px = {
  meta: clean(import.meta.env.PUBLIC_META_PIXEL_ID, /^\d{6,20}$/),
  tiktok: clean(import.meta.env.PUBLIC_TIKTOK_PIXEL_ID, /^[A-Z0-9]{10,30}$/i),
};
const fbVerify = clean(import.meta.env.PUBLIC_META_DOMAIN_VERIFICATION, /^[a-z0-9]{10,64}$/i);
const ogImage = new URL('/og-omyra.jpg', site.url).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0F3D2E" />
    {fbVerify && <meta name="facebook-domain-verification" content={fbVerify} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content="Omyra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    {!bare && <Header tone={headerTone} />}
    {bare ? <slot /> : <main id="contenido"><slot /></main>}
    {!bare && <Footer />}
    <CookieBanner />
    <script is:inline type="application/json" id="px-cfg" set:html={JSON.stringify(px)} />
    <script>
      import '../scripts/motion';
      import '../scripts/source';
      import '../scripts/consent';
    </script>
  </body>
</html>
