# Solo para servidores Apache (por ejemplo, alojamientos compartidos tipo cPanel).
# Netlify, Cloudflare Pages y similares no lo necesitan y lo ignoran.
ErrorDocument 404 /404.html
Options -MultiViews
RewriteEngine On
# Forzar HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Direcciones limpias: /precios sirve /precios.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
